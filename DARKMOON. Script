local function CreateCircleAimGui()
	if CircleAimGui then CircleAimGui:Destroy() end

	CircleAimGui                  = Instance.new("ScreenGui")
	CircleAimGui.Name             = "NeonCircleAimGUI"
	CircleAimGui.ResetOnSpawn     = false
	CircleAimGui.DisplayOrder     = 999
	CircleAimGui.IgnoreGuiInset   = true
	CircleAimGui.Parent           = GetGuiParent()

	local camera = Workspace.CurrentCamera
	local vp     = camera.ViewportSize
	CircleAimCenter = Vector2.new(vp.X / 2, vp.Y / 2)

	local diameter    = CircleAimRadius * 2

	-- Frame principal (fundo invisível, só a borda aparece)
	local CircleFrame              = Instance.new("Frame")
	CircleFrame.Name               = "CircleAimRing"
	CircleFrame.Size               = UDim2.new(0, diameter, 0, diameter)
	CircleFrame.Position           = UDim2.new(0, CircleAimCenter.X - CircleAimRadius, 0, CircleAimCenter.Y - CircleAimRadius)
	CircleFrame.BackgroundTransparency = 1
	CircleFrame.BorderSizePixel    = 0
	CircleFrame.Active             = true
	CircleFrame.Parent             = CircleAimGui

	local Corner               = Instance.new("UICorner")
	Corner.CornerRadius        = UDim.new(1, 0)   -- 100% = círculo perfeito
	Corner.Parent              = CircleFrame

	local Stroke               = Instance.new("UIStroke")
	Stroke.Color               = Color3.fromRGB(255, 0, 0)
	Stroke.Thickness           = 2.5
	Stroke.Transparency        = 0
	Stroke.ApplyStrokeMode     = Enum.ApplyStrokeMode.Border
	Stroke.Parent              = CircleFrame

	-- Crosshair central (4 linhas pequenas)
	local function MakeLine(w, h, ox, oy)
		local f               = Instance.new("Frame")
		f.Size                = UDim2.new(0, w, 0, h)
		f.Position            = UDim2.new(0.5, ox, 0.5, oy)
		f.BackgroundColor3    = Color3.fromRGB(255, 0, 0)
		f.BackgroundTransparency = 0.15
		f.BorderSizePixel     = 0
		f.Parent              = CircleFrame
		return f
	end
	MakeLine(10, 1,  -5,  0)   -- esquerda
	MakeLine(10, 1,   0,  0)   -- direita (gap central)
	MakeLine(1, 10,   0, -5)   -- cima
	MakeLine(1, 10,   0,  0)   -- baixo

	-- Ponto central
	local Dot              = Instance.new("Frame")
	Dot.Size               = UDim2.new(0, 3, 0, 3)
	Dot.Position           = UDim2.new(0.5, -1, 0.5, -1)
	Dot.BackgroundColor3   = Color3.fromRGB(255, 0, 0)
	Dot.BackgroundTransparency = 0
	Dot.BorderSizePixel    = 0
	Dot.Parent             = CircleFrame
	local DotCorner        = Instance.new("UICorner")
	DotCorner.CornerRadius = UDim.new(1, 0)
	DotCorner.Parent       = Dot

	-- Label de status (abaixo do círculo)
	local StatusLabel              = Instance.new("TextLabel")
	StatusLabel.Name               = "StatusLabel"
	StatusLabel.Size               = UDim2.new(0, diameter + 80, 0, 18)
	StatusLabel.Position           = UDim2.new(0.5, -(diameter + 80) / 2, 1, 6)
	StatusLabel.BackgroundTransparency = 1
	StatusLabel.Text               = "● SEM ALVO"
	StatusLabel.TextColor3         = Color3.fromRGB(160, 160, 160)
	StatusLabel.Font               = Enum.Font.GothamBold
	StatusLabel.TextSize           = 11
	StatusLabel.TextStrokeTransparency = 0.4
	StatusLabel.TextStrokeColor3   = Color3.new(0, 0, 0)
	StatusLabel.Parent             = CircleFrame

	-- ── Drag com botão DIREITO do mouse ───────
	local dragging       = false
	local dragStartInput = nil
	local dragStartCenter = nil

	CircleFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging        = true
			dragStartInput  = input.Position
			dragStartCenter = CircleAimCenter
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

		local delta      = input.Position - dragStartInput
		local newX       = math.clamp(dragStartCenter.X + delta.X, CircleAimRadius, vp.X - CircleAimRadius)
		local newY       = math.clamp(dragStartCenter.Y + delta.Y, CircleAimRadius, vp.Y - CircleAimRadius)
		CircleAimCenter  = Vector2.new(newX, newY)
		CircleFrame.Position = UDim2.new(0, newX - CircleAimRadius, 0, newY - CircleAimRadius)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = false
		end
	end)

	-- ── Loop de feedback visual ───────────────
	local _pulseTween        = nil
	local _lastStatusUpdate  = 0

	CircleAimConnection = RunService.Heartbeat:Connect(function()
		local now = tick()
		if now - _lastStatusUpdate < 0.1 then return end
		_lastStatusUpdate = now
		if not CircleAimEnabled then return end

		local target = GetPlayerInsideCircle()
		if target then
			StatusLabel.Text       = "🎯 " .. target.Name
			StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
			Stroke.Color           = Color3.fromRGB(255, 60, 60)
			Stroke.Thickness       = 3

			if not _pulseTween or _pulseTween.PlaybackState ~= Enum.PlaybackState.Playing then
				_pulseTween = TweenService:Create(
					Stroke,
					TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
					{ Transparency = 0.5 }
				)
				_pulseTween:Play()
			end
		else
			StatusLabel.Text       = "● SEM ALVO"
			StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
			Stroke.Color           = Color3.fromRGB(255, 0, 0)
			Stroke.Thickness       = 2.5
			Stroke.Transparency    = 0

			if _pulseTween then _pulseTween:Cancel() _pulseTween = nil end
		end
	end)
end

