    local function findJoint(char, names)
        for _,desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Motor6D") then
                local dName=desc.Name:lower()
                local p1Name=desc.Part1 and desc.Part1.Name:lower() or ""
                for _,n in ipairs(names) do
                    local target=n:lower()
                    if dName==target or p1Name==target then
                        return desc
                    end
                end
            end
        end
        return nil
    end

    local function capturePoseJoints(char)
        savedJoints={}
        if not char then return end
        local specs={
            waist={"Waist","RootJoint","Root"},
            neck={"Neck"},
            rShoulder={"RightShoulder","Right Shoulder","RightUpperArm","Right Arm"},
            lShoulder={"LeftShoulder","Left Shoulder","LeftUpperArm","Left Arm"},
            rElbow={"RightElbow","RightLowerArm"},
            lElbow={"LeftElbow","LeftLowerArm"},
            rHip={"RightHip","Right Hip","RightUpperLeg","Right Leg"},
            lHip={"LeftHip","Left Hip","LeftUpperLeg","Left Leg"},
            rKnee={"RightKnee","RightLowerLeg"},
            lKnee={"LeftKnee","LeftLowerLeg"}
        }
        for key,names in pairs(specs) do
            local j=findJoint(char,names)
            if j then
                savedJoints[key]={joint=j,c0=j.C0,c1=j.C1}
            end
        end
    end

    local function applyJointOffset(entry, offsetCFrame, alpha)
        if not entry or not entry.joint or not entry.joint.Parent then return end
        local goal=entry.c0*offsetCFrame
        entry.joint.C0=entry.joint.C0:Lerp(goal,math.clamp(alpha,0,1))
    end

    local function restorePoseJoints()
        for _,entry in pairs(savedJoints) do
            if entry and entry.joint and entry.joint.Parent then
                pcall(function()
                    entry.joint.C0=entry.c0
                end)
            end
        end
        savedJoints={}
    end

    local function restoreAntiFlingCollisions()
        for part,canCollide in pairs(antiFlingCache) do
            if part and part.Parent then
                pcall(function() part.CanCollide=canCollide end)
            end
        end
        antiFlingCache={}
    end

    local function stepAntiFling()
        if not antiFlingOn then return end

        for _,p in ipairs(Players:GetPlayers()) do
            if p~=player and p.Character then
                for _,desc in ipairs(p.Character:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        if antiFlingCache[desc]==nil then
                            antiFlingCache[desc]=desc.CanCollide
                        end
                        desc.CanCollide=false
                    end
                end
            end
        end

        local char,root,_=getChar()
        if not char or not root then return end

        local maxLinVel=flying and math.max(flySpeed*1.6,160) or 110
        local maxAngVel=28

        for _,desc in ipairs(char:GetDescendants()) do
            if desc:IsA("BasePart") then
                local lv=desc.AssemblyLinearVelocity
                if lv.Magnitude>maxLinVel then
                    local clampedY=flying and lv.Y or math.clamp(lv.Y,-maxLinVel,85)
                    local horiz=Vector3.new(lv.X,0,lv.Z)
                    if horiz.Magnitude>maxLinVel then
                        horiz=horiz.Unit*maxLinVel
                    end
                    desc.AssemblyLinearVelocity=Vector3.new(horiz.X,clampedY,horiz.Z)
                end

                local av=desc.AssemblyAngularVelocity
                if av.Magnitude>maxAngVel then
                    desc.AssemblyAngularVelocity=av.Unit*maxAngVel
                end
            end
        end
    end

    local function stepAntiVoid()
        if not antiVoidOn then return end
        local char,root,hum=getChar()
        if not char or not root or not hum or hum.Health<=0 then return end

        if root.Position.Y>voidThreshold+25 and hum.FloorMaterial~=Enum.Material.Air then
            lastSafeCFrame=root.CFrame+Vector3.new(0,3,0)
        end

        if root.Position.Y<voidThreshold then
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
            if lastSafeCFrame then
                root.CFrame=lastSafeCFrame
            else
                root.CFrame=CFrame.new(root.Position.X,math.max(voidThreshold+90,45),root.Position.Z)
            end
            setStatus("ANTI-VOID SAVED")
        end
    end

    local function clearWebVisual()
        if webBeam then pcall(function() webBeam:Destroy() end) webBeam=nil end
        if anchorAtt then pcall(function() anchorAtt:Destroy() end) anchorAtt=nil end
        if webAnchor then pcall(function() webAnchor:Destroy() end) webAnchor=nil end
    end

    local function stopFly()
        flying=false
        swingPhase=0
        webZipUntil=0
        currentVelVec=Vector3.zero
        if flyConn then flyConn:Disconnect() flyConn=nil end
        if linVel then pcall(function() linVel:Destroy() end) linVel=nil end
        if alignOri then pcall(function() alignOri:Destroy() end) alignOri=nil end
        if flyAtt then pcall(function() flyAtt:Destroy() end) flyAtt=nil end
        clearWebVisual()
        restorePoseJoints()
        local _,_,hum=getChar()
        if hum then
            pcall(function()
                hum.PlatformStand=false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end

    local function getWebAnchor(root,cam,char)
        local rayParams=RaycastParams.new()
        rayParams.FilterType=Enum.RaycastFilterType.Exclude
        if char then rayParams.FilterDescendantsInstances={char} end
        local dir=(cam.CFrame.LookVector*0.48+Vector3.new(0,0.85,0)).Unit*160
        local hit=workspace:Raycast(root.Position+Vector3.new(0,2,0),dir,rayParams)
        if hit then return hit.Position end
        return root.Position+cam.CFrame.LookVector*40+Vector3.new(0,52,0)
    end

    local function ensureWebVisual(att0,anchorPos)
        if not att0 or not att0.Parent then return end
        if not webAnchor or not webAnchor.Parent then
            webAnchor=make("Part",{
                Name="DarkMoonWebAnchor",
                Size=Vector3.new(0.2,0.2,0.2),
                Anchored=true,
                CanCollide=false,
                Transparency=1
            },workspace)
        end
        webAnchor.Position=anchorPos

        if not anchorAtt or not anchorAtt.Parent then
            anchorAtt=make("Attachment",{Name="DarkMoonAnchorAtt"},webAnchor)
        end
        if not webBeam or not webBeam.Parent then
            webBeam=make("Beam",{
                Name="DarkMoonWebLine",
                Attachment0=att0,
                Attachment1=anchorAtt,
                Color=ColorSequence.new(C.ACCENT,Color3.new(1,1,1)),
                Width0=0.14,
                Width1=0.07,
                FaceCamera=true,
                LightEmission=0.45
            },webAnchor)
        end
    end

    local function updateSpiderBodyPose(curRoot,lookDir,roll,pitch,swingArc,zipping,dt)
        local blend=math.clamp((dt or 0.016)*14,0.12,1)
        local reachRight=swingArc>=0

        if zipping then
            -- Iconic crouched Spider-Man web-zip / dive pose
            applyJointOffset(savedJoints.waist, CFrame.Angles(0.38, 0, -roll*0.35), blend)
            applyJointOffset(savedJoints.neck, CFrame.Angles(-0.42, 0, 0), blend)
            applyJointOffset(savedJoints.rShoulder, CFrame.Angles(math.rad(155), 0, math.rad(-14)), blend)
            applyJointOffset(savedJoints.lShoulder, CFrame.Angles(math.rad(150), 0, math.rad(14)), blend)
            applyJointOffset(savedJoints.rElbow, CFrame.Angles(math.rad(22), 0, 0), blend)
            applyJointOffset(savedJoints.lElbow, CFrame.Angles(math.rad(22), 0, 0), blend)
            applyJointOffset(savedJoints.rHip, CFrame.Angles(math.rad(68), math.rad(12), math.rad(-10)), blend)
            applyJointOffset(savedJoints.lHip, CFrame.Angles(math.rad(42), math.rad(-12), math.rad(10)), blend)
            applyJointOffset(savedJoints.rKnee, CFrame.Angles(math.rad(-95), 0, 0), blend)
            applyJointOffset(savedJoints.lKnee, CFrame.Angles(math.rad(-68), 0, 0), blend)
        else
            applyJointOffset(
                savedJoints.waist,
                CFrame.Angles(0.16+math.abs(pitch)*0.28,math.sin(swingPhase)*0.24,-roll*0.5),
                blend
            )
            applyJointOffset(
                savedJoints.neck,
                CFrame.Angles(-pitch*0.48-0.14,0,-roll*0.35),
                blend
            )

            if reachRight then
                local lift=0.55+math.max(0,swingArc)*0.45
                applyJointOffset(savedJoints.rShoulder, CFrame.Angles(math.rad(130+lift*35),0,math.rad(-20)), blend)
                applyJointOffset(savedJoints.rElbow, CFrame.Angles(math.rad(18),0,0), blend)
                applyJointOffset(savedJoints.lShoulder, CFrame.Angles(math.rad(-32-swingArc*18),0,math.rad(28)), blend)
                applyJointOffset(savedJoints.lElbow, CFrame.Angles(math.rad(25),0,0), blend)
            else
                local lift=0.55+math.max(0,-swingArc)*0.45
                applyJointOffset(savedJoints.lShoulder, CFrame.Angles(math.rad(130+lift*35),0,math.rad(20)), blend)
                applyJointOffset(savedJoints.lElbow, CFrame.Angles(math.rad(18),0,0), blend)
                applyJointOffset(savedJoints.rShoulder, CFrame.Angles(math.rad(-32+swingArc*18),0,math.rad(-28)), blend)
                applyJointOffset(savedJoints.rElbow, CFrame.Angles(math.rad(25),0,0), blend)
            end

            local legKick=math.sin(swingPhase)*0.34
            applyJointOffset(savedJoints.rHip, CFrame.Angles(0.32+legKick,0.1,-0.08), blend)
            applyJointOffset(savedJoints.lHip, CFrame.Angles(-0.24-legKick,-0.1,0.08), blend)
            applyJointOffset(savedJoints.rKnee, CFrame.Angles(-math.max(0,0.65+legKick*0.75),0,0), blend)
            applyJointOffset(savedJoints.lKnee, CFrame.Angles(-math.max(0,0.40-legKick*0.75),0,0), blend)
        end

        local baseCFrame=CFrame.lookAt(curRoot.Position,curRoot.Position+lookDir)
        alignOri.CFrame=baseCFrame*CFrame.Angles(pitch,0,roll)
    end

    local function startFly()
        stopFly()
        local char,root,hum=getChar()
        if not root or not hum then return false end

        flying=true
        swingPhase=0
        currentVelVec=Vector3.zero
        capturePoseJoints(char)

        flyAtt=make("Attachment",{Name="DarkMoonFlyAtt"},root)
        linVel=make("LinearVelocity",{
            Name="DarkMoonLinVel",
            Attachment0=flyAtt,
            MaxForce=math.huge,
            VelocityConstraintMode=Enum.VelocityConstraintMode.Vector,
            RelativeTo=Enum.ActuatorRelativeTo.World,
            VectorVelocity=Vector3.zero
        },root)

        alignOri=make("AlignOrientation",{
            Name="DarkMoonAlignOri",
            Attachment0=flyAtt,
            Mode=Enum.OrientationAlignmentMode.OneAttachment,
            MaxTorque=math.huge,
            Responsiveness=35,
            CFrame=root.CFrame
        },root)

        hum.PlatformStand=true

        flyConn=RunService.RenderStepped:Connect(function(dt)
            local curChar,curRoot,curHum=getChar()
            if not flying or not curChar or not curRoot or not curRoot.Parent or not curHum or curHum.Health<=0 then
                stopFly()
                return
            end
            if not linVel or not linVel.Parent or not alignOri or not alignOri.Parent or not flyAtt or not flyAtt.Parent then
                stopFly()
                return
            end

            curHum.PlatformStand=true
            local cam=workspace.CurrentCamera
            if not cam then return end

            local moveDir=Vector3.zero
            local verticalInput=0

            if not UIS:GetFocusedTextBox() then
                local forward=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
                if forward.Magnitude>1e-4 then forward=forward.Unit else forward=Vector3.new(0,0,-1) end
                local rightVec=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
                if rightVec.Magnitude>1e-4 then rightVec=rightVec.Unit else rightVec=Vector3.new(1,0,0) end

                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir=moveDir+forward end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir=moveDir-forward end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir=moveDir+rightVec end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir=moveDir-rightVec end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then verticalInput=verticalInput+1 end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then verticalInput=verticalInput-1 end
            end

            local stickDir=curHum.MoveDirection
            if stickDir.Magnitude>0.05 then
                moveDir=moveDir+Vector3.new(stickDir.X,0,stickDir.Z)
            end

            local zipping=os.clock()<webZipUntil
            if zipping then
                verticalInput=verticalInput+1.15
                if moveDir.Magnitude<0.05 then
                    local camFlat=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
                    if camFlat.Magnitude>1e-4 then moveDir=camFlat.Unit end
                end
            end

            if moveDir.Magnitude>1 then moveDir=moveDir.Unit end

            local activeMove=moveDir.Magnitude>0.05 or math.abs(verticalInput)>0.05
            swingPhase=swingPhase+(dt or 0.016)*(activeMove and 5.6 or 1.8)
            local swingArc=math.sin(swingPhase)
            local pendulumLift=swingArc*(flySpeed*0.16)
            local effectiveSpeed=zipping and (flySpeed*1.45) or flySpeed
            local targetVel=moveDir*effectiveSpeed+Vector3.new(0,verticalInput*(flySpeed*0.78)+pendulumLift,0)

            currentVelVec=currentVelVec:Lerp(targetVel,math.clamp((dt or 0.016)*10,0.08,1))
            linVel.VectorVelocity=currentVelVec
            curRoot.AssemblyLinearVelocity=currentVelVec
            curRoot.AssemblyAngularVelocity=Vector3.zero

            local anchorPos=getWebAnchor(curRoot,cam,curChar)
            ensureWebVisual(flyAtt,anchorPos)

            local lookDir=moveDir.Magnitude>0.05 and moveDir or Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
            if lookDir.Magnitude<1e-4 then lookDir=Vector3.new(0,0,-1) else lookDir=lookDir.Unit end
            local pitch=-math.clamp(currentVelVec.Y/math.max(flySpeed,1),-0.45,0.55)-(zipping and 0.28 or 0.16)
            local roll=zipping and 0 or (-swingArc*0.25)
            updateSpiderBodyPose(curRoot,lookDir,roll,pitch,swingArc,zipping,dt)
        end)
        return true
    end

    local function triggerAirDash()
        if not airDashOn then return end
        if os.clock()-lastDashTime<0.75 then return end
        local _,root,hum=getChar()
        local cam=workspace.CurrentCamera
        if not root or not hum or not cam then return end
        lastDashTime=os.clock()
        local dir=hum.MoveDirection.Magnitude>0.1 and hum.MoveDirection.Unit or Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z).Unit
        root.AssemblyLinearVelocity=dir*115+Vector3.new(0,22,0)
        setStatus("AIR DASH")
    end

