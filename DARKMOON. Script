local KnifeHitboxEnabled  = false
local HitboxRange         = 15
local HitboxType          = "Original"
local _hitboxLast         = 0
local _savedRootSizes     = {}
local _hitboxNoclipConn   = nil

local function StopHitboxNoclip()
	if _hitboxNoclipConn then
		_hitboxNoclipConn:Disconnect()
		_hitboxNoclipConn = nil
	end
end

local function StartHitboxNoclip()
	StopHitboxNoclip()
	_hitboxNoclipConn = RunService.Stepped:Connect(function()
		if not KnifeHitboxEnabled or HitboxType ~= "HumanoidRootPart" then return end
		if not LocalPlayer.Character then return end
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local root = p.Character:FindFirstChild("HumanoidRootPart")
				if root then root.CanCollide = false end
			end
		end
	end)
end

local function RestoreHRPHitboxes()
	for player, data in pairs(_savedRootSizes) do
		if player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				root.Size        = data.size
				root.Transparency = data.transparency
				root.CanCollide  = data.canCollide
			end
		end
	end
	_savedRootSizes = {}
	StopHitboxNoclip()
end

CombatTab:Toggle("Knife Hitbox (Reach)", false, function(enabled)
	KnifeHitboxEnabled = enabled
	if not enabled then RestoreHRPHitboxes() end
end)

CombatTab:Slider("Hitbox Range", 5, 50, 15, function(val)
	HitboxRange = val
end)

CombatTab:Dropdown("Hitbox Type", { "Original (Bring)", "HumanoidRootPart (Size)" }, function(selected)
	RestoreHRPHitboxes()
	HitboxType = (selected == "HumanoidRootPart (Size)") and "HumanoidRootPart" or "Original"
	if HitboxType == "HumanoidRootPart" and KnifeHitboxEnabled then
		StartHitboxNoclip()
	end
end, "Original (Bring)")

RunService.Heartbeat:Connect(function()
	if not KnifeHitboxEnabled then return end
	local now = tick()
	if now - _hitboxLast < 0.05 then return end
	_hitboxLast = now

	if HitboxType == "HumanoidRootPart" then
		if not _hitboxNoclipConn then StartHitboxNoclip() end

		for _, p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local root = p.Character:FindFirstChild("HumanoidRootPart")
				local hum  = p.Character:FindFirstChild("Humanoid")
				if root and hum and hum.Health > 0 then
					if not _savedRootSizes[p] then
						_savedRootSizes[p] = {
							size         = root.Size,
							transparency = root.Transparency,
							canCollide   = root.CanCollide,
						}
					end
					root.Size        = Vector3.new(HitboxRange, HitboxRange, HitboxRange)
					root.Transparency = 1
					root.CanCollide  = false
				end
			end
		end

		for p, _ in pairs(_savedRootSizes) do
			if not p.Parent then _savedRootSizes[p] = nil end
		end
		return
	end

	StopHitboxNoclip()

	local char = LocalPlayer.Character
	if not char then return end
	local root        = char:FindFirstChild("HumanoidRootPart")
	local holdingKnife = char:FindFirstChild("Knife")
	if not root or not holdingKnife then return end

	local myPos = root.Position
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local enemyRoot = p.Character:FindFirstChild("HumanoidRootPart")
			local hum       = p.Character:FindFirstChild("Humanoid")
			if enemyRoot and hum and hum.Health > 0 then
				local dist = (myPos - enemyRoot.Position).Magnitude
				if dist <= HitboxRange and dist > 4 then
					enemyRoot.CFrame = root.CFrame * CFrame.new(0, 0, -3)
					enemyRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				end
			end
		end
	end
end)

