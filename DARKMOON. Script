local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasLineOfSight(targetPart, targetCharacter)
	if not Settings.WallCheck then return true end
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character, targetCharacter }
	local origin = Camera.CFrame.Position
	local direction = targetPart.Position - origin
	return workspace:Raycast(origin, direction, rayParams) == nil
end

local function getAimPartForCharacter(char)
	if not char then return nil end
	return char:FindFirstChild(Settings.AimPart) or char:FindFirstChild("HumanoidRootPart")
end

local function computePredictedPosition(targetPart)
	return targetPart.Position + (targetPart.AssemblyLinearVelocity * Settings.Prediction)
end

local function findCandidateTarget(requireRoleMatch, enforceScreenChecks)
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local viewportCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
	local bestPart = nil
	local bestScore = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end

		local role = getRole(player)
		if requireRoleMatch then
			if Settings.AimPriority == "Murderer" and role ~= "Murderer" then
				continue
			elseif Settings.AimPriority == "Sheriff" and role ~= "Sheriff" then
				continue
			end
		end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local aimPart = getAimPartForCharacter(char)

		if char and hum and hum.Health > 0 and aimPart then
			local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
			local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
			local passesScreen = true
			if enforceScreenChecks then
				passesScreen = onScreen and (Settings.IgnoreFOV or (screenDist <= Settings.FOVRadius))
			end

			if passesScreen and hasLineOfSight(aimPart, char) then
				local metric = (Settings.AimPriority == "Nearest") and (aimPart.Position - myRoot.Position).Magnitude or screenDist
				if metric < bestScore then
					bestScore = metric
					bestPart = aimPart
				end
			end
		end
	end

	return bestPart
end

local function getBestAimTarget()
	local matched = findCandidateTarget(true, true)
	if matched then return matched end
	if Settings.IgnoreFOV then
		return findCandidateTarget(false, true)
	end
	return nil
end

local function getSilentAimTargetPart()
	-- Prioritize active Murderer when AimPriority is Murderer (or when Strict Murder mode is active)
	if Settings.AimPriority == "Murderer" or Settings.SilentAimMode == "Strict" then
		local murderPlr = findActiveMurderer()
		if murderPlr then
			local mPart = getAimPartForCharacter(murderPlr.Character)
			if mPart and hasLineOfSight(mPart, murderPlr.Character) then
				return mPart
			end
		end
		if Settings.SilentAimMode == "Strict" then
			return nil
		end
	end

	return findCandidateTarget(true, false) or findCandidateTarget(false, false)
end

_G.DarkmoonGetAimPoint = function(fallbackWorldPos)
	if not Settings.SilentAim then
		return fallbackWorldPos
	end
	local sPart = getSilentAimTargetPart()
	if sPart then
		return computePredictedPosition(sPart)
	end
	if currentSilentTargetPos then
		return currentSilentTargetPos
	end
	return fallbackWorldPos
end

