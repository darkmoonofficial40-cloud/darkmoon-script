        GodModeState.Active = s
        if s then ActivateGodMode(LocalPlayer.Character) else DeactivateGodMode() end
        _AdminReportState("GodMode", s)
    end,

    AntiFling = function(s)
        AntiFlingEnabled = s
        if AntiFlingConnection then AntiFlingConnection:Disconnect() AntiFlingConnection = nil end
        if not s then
            SetNoCollisionWithPlayers(false)
        else
            SetNoCollisionWithPlayers(true)
            AntiFlingConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                if root.Velocity.Magnitude > 200 then
                    root.Velocity = Vector3.new(0,0,0)
                    root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    root.AssemblyAngularVelocity = Vector3.new(0,0,0)
                end
            end)
        end
        _AdminReportState("AntiFling", s)
    end,

    AntiVoid = function(s)
        AntiVoidEnabled = s
        if AntiVoidConnection then AntiVoidConnection:Disconnect() AntiVoidConnection = nil end
        if s then
            AntiVoidConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                if root.Position.Y < -100 then
                    local sp = Workspace:FindFirstChild("SpawnLocation")
                    root.CFrame = sp and sp.CFrame + Vector3.new(0,5,0) or CFrame.new(0,10,0)
                    root.Velocity = Vector3.new(0,0,0)
                end
            end)
        end
        _AdminReportState("AntiVoid", s)
    end,

    InstantGun = function(s)
        InstantGrabGunEnabled = s
        if InstantGrabGunConnection then InstantGrabGunConnection:Disconnect() InstantGrabGunConnection = nil end
        if s then
            InstantGrabGunConnection = RunService.Heartbeat:Connect(function() InstantGrabGun() end)
        end
        _AdminReportState("InstantGun", s)
    end,

    AutoBreakGun = function(s)
        AutoBreakGunEnabled = s
        for _, conn in pairs(AutoBreakGunConnections) do if conn then conn:Disconnect() end end
        AutoBreakGunConnections = {}
        if s then
            LocalPlayer.CharacterAdded:Connect(MonitorGun)
            if LocalPlayer.Character then MonitorGun(LocalPlayer.Character) end
        end
        _AdminReportState("AutoBreakGun", s)
    end,

    -- ── TROLL COMMANDS (recebidos do Admin GUI) ──
    TrollFreeze  = function(s) _SetFreeze(s)  end,
    TrollControl = function(s) _SetControl(s) end,
    TrollKill    = function()  _DoKill()      end,
    TrollMove    = function(x,y,z) _DoMove(x,y,z) end,
}

