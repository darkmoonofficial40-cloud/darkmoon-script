local AutoThrowEnabled = false
local AutoThrowLoop    = nil

-- Sistema de animações dinâmicas do Knife
local KnifeAnimIds    = {}
local _knifeAnimWatchers = {}
local ANIM_NAMES      = { "ThrowCharge", "ThrowHold", "ThrowKnife" }

local function ScanKnifeAnims(knifeClient)
	for _, name in ipairs(ANIM_NAMES) do
		local anim = knifeClient:FindFirstChild(name)
		if anim and anim:IsA("Animation") and anim.AnimationId ~= "" then
			KnifeAnimIds[name] = anim.AnimationId
		end
	end
end

local function ClearKnifeAnims()
	for _, name in ipairs(ANIM_NAMES) do KnifeAnimIds[name] = nil end
end

local function WatchKnifeClient(knifeClient)
	ScanKnifeAnims(knifeClient)

	local connAdded = knifeClient.DescendantAdded:Connect(function(obj)
		if obj:IsA("Animation") and KnifeAnimIds[obj.Name] == nil then
			task.delay(0.05, function()
				if obj and obj.Parent and obj.AnimationId ~= "" then
					KnifeAnimIds[obj.Name] = obj.AnimationId
				end
			end)
		end
	end)

	local connRemoving = knifeClient.DescendantRemoving:Connect(function(obj)
		if obj:IsA("Animation") then KnifeAnimIds[obj.Name] = nil end
	end)

	table.insert(_knifeAnimWatchers, connAdded)
	table.insert(_knifeAnimWatchers, connRemoving)
end

local function StopKnifeWatchers()
	for _, conn in ipairs(_knifeAnimWatchers) do conn:Disconnect() end
	_knifeAnimWatchers = {}
	ClearKnifeAnims()
end

local function StartKnifeObserver()
	local function TryAttach(parent)
		if not parent then return end
		local knife = parent:FindFirstChild("Knife")
		if knife then
			local kc = knife:FindFirstChild("KnifeClient")
			if kc then WatchKnifeClient(kc) end
		end
		parent.ChildAdded:Connect(function(child)
			if child.Name == "Knife" then
				child.ChildAdded:Connect(function(c)
					if c.Name == "KnifeClient" then WatchKnifeClient(c) end
				end)
				local kc = child:FindFirstChild("KnifeClient")
				if kc then WatchKnifeClient(kc) end
			end
		end)
		parent.ChildRemoved:Connect(function(child)
			if child.Name == "Knife" then StopKnifeWatchers() end
		end)
	end

	TryAttach(LocalPlayer.Backpack)

	LocalPlayer.CharacterAdded:Connect(function(char)
		StopKnifeWatchers()
		task.wait(0.2)
		TryAttach(char)
		TryAttach(LocalPlayer.Backpack)
	end)

	if LocalPlayer.Character then TryAttach(LocalPlayer.Character) end
end

StartKnifeObserver()

local function PlayKnifeAnim(animName)
	pcall(function()
		local animId = KnifeAnimIds[animName]
		if not animId or animId == "" then return end

		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
		if not hum then return end
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then return end

		local animObj     = Instance.new("Animation")
		animObj.AnimationId = animId
		local track       = animator:LoadAnimation(animObj)
		track:Play()
		animObj:Destroy()
	end)
end

