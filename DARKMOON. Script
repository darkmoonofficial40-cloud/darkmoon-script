local function GetPredictedPosition(target)
	if not target or not target.Character then return nil end
	local root = target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local ping = LocalPlayer:GetNetworkPing()
	return root.CFrame + (root.Velocity * (ping + 0.05))
end

-- ============================================
-- PREDICTION (Speed + aceleração)
-- ============================================
local _speedPredHistory     = {}
local _speedPredTarget      = nil
local SPEED_PRED_HISTORY_SIZE = 6
local _speedTrackUsers      = { type = false, dot = false }
local _speedTrackConn       = nil

local function GetRootVelocity(root)
	local v = root.AssemblyLinearVelocity
	if v ~= Vector3.new(0, 0, 0) then return v end
	return root.Velocity
end

local function UpdateSpeedPredHistory(target)
	if not target or not target.Character then
		_speedPredHistory = {}
		return
	end
	local root = target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	if _speedPredTarget ~= target then
		_speedPredTarget  = target
		_speedPredHistory = {}
	end

	table.insert(_speedPredHistory, { t = tick(), pos = root.Position, vel = GetRootVelocity(root) })
	while #_speedPredHistory > SPEED_PRED_HISTORY_SIZE do
		table.remove(_speedPredHistory, 1)
	end
end

local function RefreshSpeedTracker()
	local need = _speedTrackUsers.type or _speedTrackUsers.dot
	if need and not _speedTrackConn then
		local last = 0
		_speedTrackConn = RunService.Heartbeat:Connect(function()
			local now = tick()
			if now - last < 0.05 then return end
			last = now
			local m = GetMurderer()
			if m then UpdateSpeedPredHistory(m) else _speedPredHistory = {} end
		end)
	elseif not need and _speedTrackConn then
		_speedTrackConn:Disconnect()
		_speedTrackConn = nil
		_speedPredHistory = {}
	end
end

local function GetSpeedPredictedPosition(target, customTime)
	if not target or not target.Character then return nil end
	local root = target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local ping     = LocalPlayer:GetNetworkPing()
	local predTime = customTime or (ping + 0.07)

	if #_speedPredHistory >= 3 and _speedPredTarget == target then
		local newest = _speedPredHistory[#_speedPredHistory]
		local oldest = _speedPredHistory[1]
		local dt     = newest.t - oldest.t
		if dt > 0 then
			local accel        = (newest.vel - oldest.vel) / dt
			local predictedPos = newest.pos + newest.vel * predTime + accel * (0.5 * predTime * predTime)
			return CFrame.new(predictedPos)
		end
	end

	return root.CFrame + (GetRootVelocity(root) * predTime)
end

