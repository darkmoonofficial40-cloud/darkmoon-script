local function cycleSpectate(dir)
	local targets = getSpectatableTargets()
	if #targets == 0 then
		spectateIndex = 0
		local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		Camera.CameraType = Enum.CameraType.Custom
		if myHum then Camera.CameraSubject = myHum end
		return "Self"
	end

	spectateIndex = spectateIndex + dir
	if spectateIndex > #targets then
		spectateIndex = 0
	elseif spectateIndex < 0 then
		spectateIndex = #targets
	end

	if spectateIndex == 0 then
		local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		Camera.CameraType = Enum.CameraType.Custom
		if myHum then Camera.CameraSubject = myHum end
		return "Self"
	else
		local entry = targets[spectateIndex]
		Camera.CameraType = Enum.CameraType.Custom
		Camera.CameraSubject = entry.Humanoid
		return entry.Player.Name
	end
end

-- Click-to-Fling Target Player
local function flingPlayer(targetPlayer)
	if isFlinging or not targetPlayer or targetPlayer == LocalPlayer then return end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

	local targetChar = targetPlayer.Character
	local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not myRoot or not myHum or not targetRoot then return end

	isFlinging = true
	local origCFrame = myRoot.CFrame
	local partsToRestore = {}

	for _, part in ipairs(myChar:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(partsToRestore, { Part = part, CanCollide = part.CanCollide })
			part.CanCollide = false
		end
	end

	myHum:ChangeState(Enum.HumanoidStateType.Physics)

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	bv.Parent = myRoot

	local bav = Instance.new("BodyAngularVelocity")
	bav.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	bav.AngularVelocity = Vector3.new(0, 65, 0)
	bav.Parent = myRoot

	local startClock = os.clock()
	while (os.clock() - startClock) < 0.35 do
		if not targetRoot.Parent or not myRoot.Parent then break end
		local predicted = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * 0.12)
		myRoot.CFrame = CFrame.new(predicted)
		local dir = (predicted - myRoot.Position)
		local unit = dir.Magnitude > 0.05 and dir.Unit or Vector3.new(0, 0, -1)
		bv.Velocity = (unit * Settings.FlingPower) + Vector3.new(0, Settings.FlingPower * 0.45, 0)
		RunService.Heartbeat:Wait()
	end

	bv:Destroy()
	bav:Destroy()

	for _, entry in ipairs(partsToRestore) do
		if entry.Part and entry.Part.Parent then
			entry.Part.CanCollide = entry.CanCollide
		end
	end

	if myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
		myRoot.CFrame = origCFrame + Vector3.new(0, 2, 0)
	end
	if myHum.Parent then
		myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	isFlinging = false
end

local function equipAttackTool()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if not char or not hum or not backpack then return nil end

	for _, item in ipairs(char:GetChildren()) do
		if item:IsA("Tool") then
			return item
		end
	end
	for _, item in ipairs(backpack:GetChildren()) do
		if item:IsA("Tool") then
			hum:EquipTool(item)
			return item
		end
	end
	return nil
end

local function hasAliveTargets()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				return true
			end
		end
	end
	return false
end

local function killAllTargets(autoRepeat)
	if isKillingAll then return end
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if not myRoot or not myHum or myHum.Health <= 0 then
		if autoRepeat then
			setSettingState("KillAllLoop", false)
		end
		return
	end

	isKillingAll = true
	local origCFrame = myRoot.CFrame

	repeat
		local tool = equipAttackTool()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr == LocalPlayer then continue end
			if autoRepeat and not Settings.KillAllLoop then break end
			if not myRoot.Parent or not myHum or myHum.Health <= 0 then break end

			local tChar = plr.Character
			local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

			if tRoot and tHum and tHum.Health > 0 then
				local strikeStart = os.clock()
				while (os.clock() - strikeStart) < 0.22 do
					if autoRepeat and not Settings.KillAllLoop then break end
					if not tRoot.Parent or not tHum or tHum.Health <= 0 or not myRoot.Parent then break end
					myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5)
					if tool and tool.Parent == myChar then
						pcall(function()
							tool:Activate()
						end)
					end
					RunService.Heartbeat:Wait()
				end
			end
		end

		if autoRepeat and Settings.KillAllLoop and hasAliveTargets() then
			RunService.Heartbeat:Wait()
		else
			break
		end
	until not autoRepeat or not Settings.KillAllLoop or not hasAliveTargets()

	if autoRepeat and Settings.KillAllLoop then
		setSettingState("KillAllLoop", false)
	end

	if myRoot and myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.CFrame = origCFrame + Vector3.new(0, 2, 0)
	end
	isKillingAll = false
end

-- In-Game Role Resolver
local function normalizeRole(raw)
	if typeof(raw) ~= "string" then return nil end
	local r = string.lower(raw)
	if r == "murder" or r == "murderer" then
		return "Murderer"
	elseif r == "sheriff" or r == "shiref" or r == "hero" then
		return "Sheriff"
	elseif r == "innocent" then
		return "Innocent"
	end
	return nil
end

local function hasRoleTool(container, keyword)
	if not container then return false end
	for _, item in ipairs(container:GetChildren()) do
		if item:IsA("Tool") and string.find(string.lower(item.Name), keyword, 1, true) then
			return true
		end
	end
	return false
end

local function getRole(player)
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	for _, container in ipairs({ player, char }) do
		if container then
			for _, boolName in ipairs({ "IsMurderer", "Murderer", "isMurder" }) do
				local b = container:FindFirstChild(boolName)
				if b and b:IsA("BoolValue") and b.Value == true then
					return "Murderer"
				end
			end
			for _, boolName in ipairs({ "IsSheriff", "Sheriff", "isSheriff" }) do
				local b = container:FindFirstChild(boolName)
				if b and b:IsA("BoolValue") and b.Value == true then
					return "Sheriff"
				end
			end

			for _, valName in ipairs({ "Role", "PlayerRole", "TeamRole" }) do
				local v = container:FindFirstChild(valName)
				if v and v:IsA("StringValue") then
					local mapped = normalizeRole(v.Value)
					if mapped then return mapped end
				end
			end

			for _, attrName in ipairs({ "Role", "PlayerRole", "TeamRole" }) do
				local attr = container:GetAttribute(attrName)
				if attr ~= nil then
					local mapped = normalizeRole(attr)
					if mapped then return mapped end
				end
			end
			if container:GetAttribute("Murderer") == true or container:GetAttribute("IsMurderer") == true then
				return "Murderer"
			end
			if container:GetAttribute("Sheriff") == true or container:GetAttribute("IsSheriff") == true then
				return "Sheriff"
			end
		end
	end

	if hasRoleTool(char, "knife") or hasRoleTool(backpack, "knife") then
		return "Murderer"
	end
	if hasRoleTool(char, "gun") or hasRoleTool(backpack, "gun")
		or hasRoleTool(char, "revolver") or hasRoleTool(backpack, "revolver") then
		return "Sheriff"
	end

	if player.Team then
		local mapped = normalizeRole(player.Team.Name)
		if mapped then return mapped end
	end

	return "Innocent"
end

local function findActiveRolePlayer(targetRole)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and getRole(plr) == targetRole then
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				return plr
			end
		end
	end
	return nil
end

local function findActiveMurderer()
	return findActiveRolePlayer("Murderer")
end

