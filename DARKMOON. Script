-- ============================================
-- TROLL: variáveis de controle remoto
-- O Admin GUI pode enviar comandos especiais
-- ============================================
local _TrollFreezeConn   = nil
local _TrollControlConn  = nil
local _TrollControlInput = nil
local _FreezeActive      = false
local _ControlActive     = false

-- Freeze: ancora o HumanoidRootPart
local function _SetFreeze(state)
    _FreezeActive = state
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChild("Humanoid")
        if not root then return end
        if state then
            root.Anchored = true
            root.Velocity = Vector3.new(0,0,0)
            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            if hum then
                hum.WalkSpeed = 0
                hum.JumpPower = 0
            end
            -- Mantém ancorado mesmo que o jogo tente soltar
            if _TrollFreezeConn then _TrollFreezeConn:Disconnect() end
            _TrollFreezeConn = RunService.Heartbeat:Connect(function()
                if not _FreezeActive then return end
                if root and root.Parent then
                    root.Anchored = true
                    root.Velocity = Vector3.new(0,0,0)
                    root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                end
            end)
        else
            if _TrollFreezeConn then _TrollFreezeConn:Disconnect() _TrollFreezeConn = nil end
            root.Anchored = false
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
        end
    end)
end

-- Control: o Admin move o personagem da vítima via FireServer
-- A vítima recebe comandos de movimento e não consegue mover
local function _SetControl(state)
    _ControlActive = state
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum  = char:FindFirstChild("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end

        if state then
            -- Trava o input do jogador: WalkSpeed 0 e bloqueia MovementMode
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            -- Bloqueia controles via UserInputService (hook no servidor não funciona,
            -- mas zeramos velocidade constantemente para simular o bloqueio)
            if _TrollControlConn then _TrollControlConn:Disconnect() end
            _TrollControlConn = RunService.Heartbeat:Connect(function()
                if not _ControlActive then return end
                if root and root.Parent then
                    root.Velocity = Vector3.new(0,0,0)
                    root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                end
            end)
        else
            if _TrollControlConn then _TrollControlConn:Disconnect() _TrollControlConn = nil end
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
    end)
end

-- Kill: mata o personagem localmente
local function _DoKill()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.Health = 0 end
    end)
end

-- Move: recebe posição do Admin e teleporta o personagem
local function _DoMove(x, y, z)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.CFrame = CFrame.new(x, y, z) end
    end)
end

