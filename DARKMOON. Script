-- ============================================
-- 4. AUTO FLICK (rotação real de câmera, sem bug)
-- ============================================
-- Como funciona:
--   1. Captura o CFrame atual da câmera
--   2. Calcula o CFrame apontando para o alvo (ida)
--   3. Usa um loop no RenderStepped para interpolar
--      a câmera ida → alvo em FlickFrames frames
--   4. Depois interpola alvo → original em ReturnFrames frames
--   5. Ao final restaura CameraType = Custom
--      O segredo de não buggar: nunca soltamos o controle
--      antes de terminar a animação, e usamos
--      uma flag _flickRunning para impedir chamadas simultâneas.
local FlickSpeed       = 5   -- ida: 1 (lento) → 10 (instantâneo)
local FlickReturnSpeed = 5   -- volta: 1 (lento) → 10 (instantâneo)
local _flickRunning    = false

DoAutoFlick = function()
	if not AutoFlickEnabled then return end
	if _flickRunning then return end  -- evita chamadas sobrepostas

	local target = GetCurrentTarget()
	if not target or not target.Character then return end
	local murdRoot = target.Character:FindFirstChild("HumanoidRootPart")
	if not murdRoot then return end

	local camera = Workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Custom then return end

	_flickRunning = true

	-- Converte slider 1-10 → frames
	-- FlickSpeed  10 = 1 frame (ultra rápido), 1 = 8 frames (lento)
	-- ReturnSpeed 10 = 2 frames (rápido),      1 = 15 frames (devagar)
	local idaFrames    = math.max(1, math.floor(8  - (FlickSpeed       - 1) / 9 * 7))
	local voltaFrames  = math.max(2, math.floor(15 - (FlickReturnSpeed - 1) / 9 * 13))

	-- Assume controle da câmera
	camera.CameraType = Enum.CameraType.Scriptable

	-- Snapshot do CFrame original DEPOIS de mudar para Scriptable
	-- (Scriptable congela a câmera onde ela estava, sem salto)
	local originCF = camera.CFrame

	-- CFrame apontando para o alvo (mantém a posição da câmera)
	local targetCF = CFrame.new(originCF.Position, murdRoot.Position)

	-- ── IDA ──────────────────────────────────
	for i = 1, idaFrames do
		RunService.RenderStepped:Wait()
		if not AutoFlickEnabled then break end
		local t    = i / idaFrames
		-- ease in quad
		local ease = t * t
		camera.CFrame = originCF:Lerp(targetCF, ease)
	end

	-- Garante frame final na posição do alvo
	if AutoFlickEnabled then
		camera.CFrame = targetCF
	end

	RunService.RenderStepped:Wait()

	-- ── VOLTA ────────────────────────────────
	-- Recaptura originCF pois o jogador pode ter movido levemente
	-- Usa a posição do alvo como ponto de partida da volta
	local flickedCF = camera.CFrame
	for i = 1, voltaFrames do
		RunService.RenderStepped:Wait()
		local t    = i / voltaFrames
		-- ease out quad: rápido no começo, suaviza no final
		local ease = 1 - (1 - t) * (1 - t)
		camera.CFrame = flickedCF:Lerp(originCF, ease)
	end

	-- Restaura controle ao Roblox
	camera.CFrame     = originCF
	camera.CameraType = Enum.CameraType.Custom
	_flickRunning     = false
end

CombatTab:Toggle("Auto Flick (Sheriff)", false, function(enabled)
	AutoFlickEnabled = enabled
	-- Se desligar no meio de um flick, força restauração
	if not enabled then
		_flickRunning = false
		local camera = Workspace.CurrentCamera
		if camera.CameraType == Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Custom
		end
	end
	if enabled then
		Notify("Auto Flick", "Ativo! Ajuste Flick Speed (ida) e Return Speed (volta).")
	end
end, "AutoFlick")

