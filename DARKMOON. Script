local function BuildCoinCache()
    _coinCache = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
            _coinCache[obj] = true
        end
    end
    _coinCacheReady = true
end

