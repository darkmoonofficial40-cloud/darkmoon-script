local Window = Library:CreateWindow({
	Title = "Murder Mystery 2 | Midnight",
	KeySystem = false,
})

local function NewTab(name)
	local tab = Window:CreateTab(name)
	local T = {}
	local function flag(n) return name .. "/" .. n end

	function T:Label(text)
		return tab:CreateSeparateText(text)
	end

	function T:Button(n, cb)
		return tab:CreateButton({Name = n, Callback = cb})
	end

	function T:Toggle(n, default, cb, adminKey)
		local obj = tab:CreateToggle({
			Name = n,
			Default = default or false,
			Flag = flag(n),
			Callback = function(v)
				local ok, err = pcall(cb, v)
				if not ok then warn("[MM2 DarkUI] " .. n .. ": " .. tostring(err)) end
				if adminKey then _AdminReportState(adminKey, v) end
			end,
		})
		if adminKey then AdminToggles[adminKey] = obj end
		return obj
	end

	function T:Slider(n, min, max, default, cb)
		return tab:CreateSlider({
			Name = n, Min = min, Max = max, Default = default,
			Increment = 1, Flag = flag(n), Callback = cb,
		})
	end

	function T:Dropdown(n, options, cb, default)
		return tab:CreateDropdown({
			Name = n, Options = options, Default = default,
			Flag = flag(n), Callback = cb,
		})
	end

	function T:Textbox(n, default, cb)
		return tab:CreateTextbox({
			Name = n, Default = default, PlaceholderText = default,
			Flag = flag(n), Callback = cb,
		})
	end

	return T
end

