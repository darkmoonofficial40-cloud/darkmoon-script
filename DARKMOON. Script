RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local bottomCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.92)

	updateGunESP(myRoot)

	local activeMurder = findActiveMurderer()
	if activeMurder then
		local mRoot = activeMurder.Character and activeMurder.Character:FindFirstChild("HumanoidRootPart")
		local mDist = (myRoot and mRoot) and (" [" .. math.floor((mRoot.Position - myRoot.Position).Magnitude) .. "m]") or ""
		QuickMurderName.Text = activeMurder.Name .. mDist
		QuickMurderName.TextColor3 = RoleColors.Murderer
		QuickFlingBtn.Active = not isFlinging
		QuickFlingBtn.BackgroundTransparency = isFlinging and 0.55 or 0
	else
		QuickMurderName.Text = "None"
		QuickMurderName.TextColor3 = Theme.TextMuted
		QuickFlingBtn.Active = false
		QuickFlingBtn.BackgroundTransparency = 0.55
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local role = getRole(player)
		local color = RoleColors[role] or RoleColors.Innocent
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local isAlive = (hum ~= nil and hum.Health > 0 and hrp ~= nil)

		local cardEntry = PlayerListCards[player]
		if cardEntry then
			cardEntry.BannerBar.BackgroundColor3 = color
			cardEntry.AccentStripe.BackgroundColor3 = color
			cardEntry.AvStroke.Color = color
			cardEntry.Stroke.Color = (role == "Murderer") and color or Theme.BorderSoft
			cardEntry.RoleBadge.TextColor3 = color
			if not isAlive then
				cardEntry.RoleBadge.Text = role .. " • DEAD"
			elseif player == LocalPlayer or not myRoot then
				cardEntry.RoleBadge.Text = role
			else
				local dist = math.floor((hrp.Position - myRoot.Position).Magnitude)
				cardEntry.RoleBadge.Text = role .. " [" .. dist .. "m]"
			end
			if cardEntry.TpBtn then
				cardEntry.TpBtn.Active = isAlive and not isFlinging
				cardEntry.TpBtn.BackgroundTransparency = (isAlive and not isFlinging) and 0 or 0.55
			end
			if cardEntry.FlingBtn then
				cardEntry.FlingBtn.Active = isAlive and not isFlinging
				cardEntry.FlingBtn.BackgroundTransparency = (isAlive and not isFlinging) and 0 or 0.55
			end
		end

		if player == LocalPlayer then continue end

		local v = getVisuals(player)
		if isAlive then
			local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
			if onScreen then
				local top = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.5, 0))
				local bottom = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
				local h = math.max(12, math.abs(bottom.Y - top.Y))
				local w = h * 0.65
				local left = pos.X - (w * 0.5)
				local topY = pos.Y - (h * 0.5)

				if Settings.RoleBoxESP then
					v.Box.Size = UDim2.new(0, w, 0, h)
					v.Box.Position = UDim2.new(0, left, 0, topY)
					v.Stroke.Color = color
					v.Box.Visible = true
				else
					v.Box.Visible = false
				end

				if Settings.RoleNameESP then
					local dist = myRoot and (" [" .. math.floor((hrp.Position - myRoot.Position).Magnitude) .. "m]") or ""
					v.Tag.Position = UDim2.new(0, pos.X, 0, topY - 3)
					v.Tag.TextColor3 = color
					v.Tag.Text = player.Name .. " • " .. role .. dist
					v.Tag.Visible = true
				else
					v.Tag.Visible = false
				end

				if Settings.RoleTracerESP then
					local targetPt = Vector2.new(pos.X, pos.Y)
					local delta = targetPt - bottomCenter
					local mid = (targetPt + bottomCenter) * 0.5
					v.Tracer.Size = UDim2.new(0, delta.Magnitude, 0, 1.5)
					v.Tracer.Position = UDim2.new(0, mid.X, 0, mid.Y)
					v.Tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					v.Tracer.BackgroundColor3 = color
					v.Tracer.BackgroundTransparency = 0.25
					v.Tracer.Visible = true
				else
					v.Tracer.Visible = false
				end
			else
				v.Box.Visible = false
				v.Tag.Visible = false
				v.Tracer.Visible = false
			end
		else
			v.Box.Visible = false
			v.Tag.Visible = false
			v.Tracer.Visible = false
		end
	end

	local silentPart = Settings.SilentAim and getSilentAimTargetPart() or nil
	currentSilentTargetPos = silentPart and computePredictedPosition(silentPart) or nil

	local markerOrLockPart = silentPart or (Settings.TargetLock and getBestAimTarget()) or nil
	if markerOrLockPart then
		local predictedPos = computePredictedPosition(markerOrLockPart)
		if Settings.ShowAimMarker then
			local mPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
			if onScreen then
				AimMarker.Position = UDim2.new(0, mPos.X, 0, mPos.Y)
				AimMarker.Visible = true
			else
				AimMarker.Visible = false
			end
		else
			AimMarker.Visible = false
		end

		if Settings.TargetLock and isAiming then
			local camPos = Camera.CFrame.Position
			local desiredCFrame = CFrame.lookAt(camPos, predictedPos)
			Camera.CFrame = Camera.CFrame:Lerp(desiredCFrame, Settings.Smoothness)
		end
	else
		AimMarker.Visible = false
	end
end)

