local InnocentTab = NewTab("Innocent")

local GodModeState = {Active = false}
local _gmHpConn = nil
local _gmDiedConn = nil

local function SafeDisconnectGM(conn)
	if conn then pcall(function() conn:Disconnect() end) end
	return nil
end

local function PurgeTransmitters(char)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
			local tt = part:FindFirstChildOfClass("TouchTransmitter")
			if tt then tt:Destroy() end
			if not part:GetAttribute("TTPurged") then
				part:SetAttribute("TTPurged", true)
				part.ChildAdded:Connect(function(child)
					if child:IsA("TouchTransmitter") then child:Destroy() end
				end)
			end
		end
	end
end

local function ActivateGodMode(char)
	char = char or LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	PurgeTransmitters(char)

	pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
	pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true) end)

	hum.MaxHealth = 100
	hum.Health = 100

	_gmHpConn = SafeDisconnectGM(_gmHpConn)
	_gmDiedConn = SafeDisconnectGM(_gmDiedConn)

	local _restoring = false
	_gmHpConn = hum.HealthChanged:Connect(function(hp)
		if not GodModeState.Active or _restoring then return end
		if hp < 100 then
			_restoring = true
			hum.Health = 100
			pcall(function()
				for _, obj in ipairs(char:GetDescendants()) do
					if obj.Name == "Wound" or obj.Name == "Blood"
					or obj.Name == "KilledBy" or obj:IsA("SelectionBox") then
						obj:Destroy()
					end
				end
			end)
			_restoring = false
		end
	end)

	_gmDiedConn = hum.Died:Connect(function()
		if not GodModeState.Active then return end
		task.defer(function()
			local h = char:FindFirstChildOfClass("Humanoid")
			if h then
				h:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
				h.Health = 100
			end
		end)
	end)

	char.DescendantAdded:Connect(function(desc)
		if desc:IsA("BasePart") then
			desc.CanCollide = true
			local tt = desc:FindFirstChildOfClass("TouchTransmitter")
			if tt then tt:Destroy() end
		end
	end)
end

local function DeactivateGodMode()
	_gmHpConn = SafeDisconnectGM(_gmHpConn)
	_gmDiedConn = SafeDisconnectGM(_gmDiedConn)
end

LocalPlayer.CharacterAdded:Connect(function(char)
	if not GodModeState.Active then return end
	task.wait(1)
	if GodModeState.Active then ActivateGodMode(char) end
end)

InnocentTab:Toggle("God Mode", false, function(enabled)
	GodModeState.Active = enabled

	if enabled then
		ActivateGodMode(LocalPlayer.Character)
		Notify("God Mode", "Activated! Imortal agora.")
	else
		DeactivateGodMode()
	end
end, "GodMode")

