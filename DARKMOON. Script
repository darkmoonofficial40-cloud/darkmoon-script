local tweenInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function selectTab(tabName)
	for name, page in pairs(Pages) do
		page.Visible = (name == tabName)
	end
	for name, btnData in pairs(TabButtons) do
		local active = (name == tabName)
		TweenService:Create(btnData.Button, tweenInfo, {
			BackgroundColor3 = active and Theme.CardBg or Theme.SidebarBg,
			TextColor3 = active and Theme.TextBright or Theme.TextMuted,
		}):Play()
		btnData.Bar.Visible = active
	end
end

