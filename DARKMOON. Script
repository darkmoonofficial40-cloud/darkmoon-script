    if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
        _coinCache[obj] = true
    end
end)

Workspace.DescendantRemoving:Connect(function(obj)
    if obj.Name == "Coin_Server" then
        _coinCache[obj]      = nil
        collectedCoins[obj]  = nil  -- limpa da lista de coletadas também
    end
end)

-- Constrói o cache na primeira vez (async para não travar o load)
