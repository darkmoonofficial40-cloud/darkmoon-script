local function findDroppedGun()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool")
            and obj.Parent ~= LocalPlayer.Character
            and obj.Parent ~= LocalPlayer.Backpack
            and not Players:GetPlayerFromCharacter(obj.Parent) then
            local tn = obj.Name:lower()
            for _, s in ipairs(SHERIFF_PATTERNS) do
                if tn:find(s) then return obj end
            end
            local isKnife = false
            for _, k in ipairs(KNIFE_PATTERNS) do
                if tn:find(k) then isKnife = true; break end
            end
            if not isKnife and obj:FindFirstChild("Handle") then
                return obj
            end
        end
    end
    return nil
end

local function isSheriffAlive()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRoleByTool(p) == "sheriff" then
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                return true
            end
        end
    end
    return false
end

