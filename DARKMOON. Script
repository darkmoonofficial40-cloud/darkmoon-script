    end

    local function updateESP()
        local myHRP = getHRP()
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local char = player.Character
            if not shouldShowESP(player) then
                removeESP(player)
                continue
            end

            local refs = espObjects[player]
            if not refs or not refs.highlight or not refs.highlight.Parent then
                if char then createESP(player) end
                continue
            end

            if not char then continue end

            local role = getRoleByTool(player)
            local color = ROLE_COLORS[role] or C.blue
            local hum = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")
            local tool = findPlayerTool(player)

            refs.highlight.FillColor = color

            if states.espWeapon and tool then
                if not refs.weaponHighlight or not refs.weaponHighlight.Parent or refs.weaponHighlight.Parent ~= tool then
                    if refs.weaponHighlight and refs.weaponHighlight.Parent then
                        refs.weaponHighlight:Destroy()
                    end
                    local wHi = Instance.new("Highlight", tool)
                    wHi.Name = "WeaponESP"
                    wHi.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    wHi.OutlineColor = Color3.fromRGB(255, 255, 255)
                    wHi.OutlineTransparency = 0
                    refs.weaponHighlight = wHi
                    table.insert(refs.instances, wHi)
                end
                refs.weaponHighlight.FillColor = role == "murderer" and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 220, 0)
                refs.weaponHighlight.FillTransparency = 0.15
            elseif refs.weaponHighlight and refs.weaponHighlight.Parent then
                refs.weaponHighlight:Destroy()
                refs.weaponHighlight = nil
            end

            if hum and head and refs.bbg and refs.bbg.Parent then
                local hp = math.max(0, math.floor(hum.Health))
                local maxHp = math.max(1, math.floor(hum.MaxHealth))
                local ratio = hp / maxHp
                local r2 = math.floor(math.min(1, 2 - ratio * 2) * 255)
                local g2 = math.floor(math.min(1, ratio * 2) * 255)
                local hpColor = Color3.fromRGB(r2, g2, 40)

                if refs.nameLabel then
                    refs.nameLabel.TextColor3 = color
                    refs.nameLabel.Text = (ROLE_ICONS[role] or "👤") .. " " .. player.DisplayName
                end
                if refs.weapLabel then
                    refs.weapLabel.Text = tool and ("🗡 " .. tool.Name) or ""
                end
                if refs.hpBarBg then
                    refs.hpBarBg.Visible = states.espHP
                end
                if refs.hpFill then
                    refs.hpFill.Size = UDim2.new(ratio, 0, 1, 0)
                    refs.hpFill.BackgroundColor3 = hpColor
                end
                if refs.hpLabel then
                    refs.hpLabel.Text = "HP: " .. hp .. "/" .. maxHp
                    refs.hpLabel.TextColor3 = hpColor
                    refs.hpLabel.Visible = states.espHP
                end
                if refs.distLabel then
                    if states.espDist and myHRP then
                        refs.distLabel.Text = "📏 " .. math.floor((myHRP.Position - head.Position).Magnitude) .. "m"
                    else
                        refs.distLabel.Text = ""
                    end
                end
            end
        end

        for p2 in pairs(espObjects) do
            if not p2 or not p2.Parent then removeESP(p2) end
        end
    end

