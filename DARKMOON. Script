local function createPage(name)
	local frame = Instance.new("Frame")
	frame.Name = name .. "Page"
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.Visible = (name == "Main")
	frame.Parent = PageContainer
	tabs[name] = frame
	return frame
end

