local function ResetHorizontalVelocity()
	local char = LocalPlayer.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0) end
	end
end

local function ApplySpeedGlitch()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local moveDir = hum.MoveDirection
	if moveDir.Magnitude == 0 then return end

	if SpeedGlitchType == "TpWalk" then
		root.CFrame = root.CFrame + moveDir * SpeedGlitchValue
	else
		root.AssemblyLinearVelocity = moveDir * (SpeedGlitchValue * 16)
	end
end

local function StartSpeedGlitch()
	ClearSpeedGlitchConnections()

	local function SetupCharacterGlitch(char)
		if not char then return end
		local hum = char:WaitForChild("Humanoid", 5)
		if not hum then return end

		if SpeedGlitchJumpConnection then SpeedGlitchJumpConnection:Disconnect() end
		SpeedGlitchJumpConnection = hum.StateChanged:Connect(function(_, newState)
			if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
				if SpeedGlitchEnabled then
					if SpeedGlitchConnection then SpeedGlitchConnection:Disconnect() end
					SpeedGlitchConnection = RunService.Heartbeat:Connect(ApplySpeedGlitch)
				end
			elseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running or newState == Enum.HumanoidStateType.RunningNoPhysics then
				if SpeedGlitchConnection then SpeedGlitchConnection:Disconnect() SpeedGlitchConnection = nil end
			end
		end)
	end

	SetupCharacterGlitch(LocalPlayer.Character)
	SpeedGlitchLandConnection = LocalPlayer.CharacterAdded:Connect(SetupCharacterGlitch)
end

