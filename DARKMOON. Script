_G.DarkMoonMM2Cleanup = function()
    for _, conn in pairs(C.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(C.Connections)
    for _, h in pairs(C.Highlights) do
        if h then pcall(function() h:Destroy() end) end
    end
    for _, h in pairs(C.GunHighlights) do
        if h then pcall(function() h:Destroy() end) end
    end
    for _, t in pairs(C.NameTags) do
        if t then pcall(function() t:Destroy() end) end
    end
    table.clear(C.Highlights)
    table.clear(C.GunHighlights)
    table.clear(C.NameTags)
    pcall(function() ScreenGui:Destroy() end)
    _G.DarkMoonMM2Loaded = false
end

