    local function updateBoxAndHealthEsp()
        if not boxEspOn and not healthBarOn then
            for _,sq in pairs(boxEspDrawings) do pcall(function() sq.Visible=false end) end
            for _,bar in pairs(healthBarDrawings) do
                pcall(function() bar.bg.Visible=false; bar.fg.Visible=false end)
            end
            return
        end

        local cam=workspace.CurrentCamera
        if not cam then return end

        for _,p in ipairs(Players:GetPlayers()) do
            if p~=player then
                local sq=boxEspOn and (boxEspDrawings[p] or createBoxDrawing()) or boxEspDrawings[p]
                if boxEspOn and sq then boxEspDrawings[p]=sq end

                local bar=healthBarOn and (healthBarDrawings[p] or createHealthBarDrawing()) or healthBarDrawings[p]
                if healthBarOn and bar then healthBarDrawings[p]=bar end

                local char=p.Character
                local root=char and char:FindFirstChild("HumanoidRootPart")
                local head=char and char:FindFirstChild("Head")
                local hum=char and char:FindFirstChildOfClass("Humanoid")

                if root and head then
                    local topPos,topVis=cam:WorldToViewportPoint(head.Position+Vector3.new(0,0.8,0))
                    local botPos,botVis=cam:WorldToViewportPoint(root.Position-Vector3.new(0,3,0))

                    if topVis and botVis and topPos.Z>0 then
                        local height=math.abs(botPos.Y-topPos.Y)
                        local width=math.clamp(height*0.55,10,300)
                        local centerX=(topPos.X+botPos.X)*0.5
                        local leftX=centerX-width*0.5
                        local topY=math.min(topPos.Y,botPos.Y)

                        if sq then
                            pcall(function()
                                sq.Size=Vector2.new(width,height)
                                sq.Position=Vector2.new(leftX,topY)
                                sq.Color=C.ACCENT
                                sq.Visible=boxEspOn
                            end)
                        end

                        if bar then
                            local ratio=hum and hum.MaxHealth>0 and math.clamp(hum.Health/hum.MaxHealth,0,1) or 1
                            local fillH=math.max(1,height*ratio)
                            pcall(function()
                                bar.bg.Size=Vector2.new(4,height)
                                bar.bg.Position=Vector2.new(leftX-7,topY)
                                bar.bg.Visible=healthBarOn

                                bar.fg.Size=Vector2.new(2,fillH)
                                bar.fg.Position=Vector2.new(leftX-6,topY+(height-fillH))
                                bar.fg.Color=ratio>0.5 and C.good or (ratio>0.25 and Color3.fromRGB(250,200,75) or C.bad)
                                bar.fg.Visible=healthBarOn
                            end)
                        end
                    else
                        if sq then pcall(function() sq.Visible=false end) end
                        if bar then pcall(function() bar.bg.Visible=false; bar.fg.Visible=false end) end
                    end
                else
                    if sq then pcall(function() sq.Visible=false end) end
                    if bar then pcall(function() bar.bg.Visible=false; bar.fg.Visible=false end) end
                end
            end
        end
    end

    local function updateTracers()
        if not tracersOn then
            for _,ln in pairs(tracerDrawings) do pcall(function() ln.Visible=false end) end
            return
        end

        local cam=workspace.CurrentCamera
        if not cam then return end
        local origin=Vector2.new(cam.ViewportSize.X*0.5,cam.ViewportSize.Y)

        for _,p in ipairs(Players:GetPlayers()) do
            if p~=player then
                local ln=tracerDrawings[p]
                if not ln then
                    ln=createTracerDrawing()
                    if ln then tracerDrawings[p]=ln end
                end

                local char=p.Character
                local root=char and char:FindFirstChild("HumanoidRootPart")
                if ln and root then
                    local pos,vis=cam:WorldToViewportPoint(root.Position)
                    if vis and pos.Z>0 then
                        pcall(function()
                            ln.From=origin
                            ln.To=Vector2.new(pos.X,pos.Y)
                            ln.Color=C.ACCENT
                            ln.Visible=true
                        end)
                    else
                        pcall(function() ln.Visible=false end)
                    end
                elseif ln then
                    pcall(function() ln.Visible=false end)
                end
            end
        end
    end

