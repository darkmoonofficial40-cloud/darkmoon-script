		local active = Settings[settingKey]
		local trackCol = active and Theme.OnTrack or Theme.OffTrack
		local knobPos = active and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
		local borderCol = active and Theme.MoonAccent or Theme.BorderSoft

		if instant then
			Track.BackgroundColor3 = trackCol
			Knob.Position = knobPos
			RowStroke.Color = borderCol
		else
			TweenService:Create(Track, tweenInfo, { BackgroundColor3 = trackCol }):Play()
			TweenService:Create(Knob, tweenInfo, { Position = knobPos }):Play()
			TweenService:Create(RowStroke, tweenInfo, { Color = borderCol }):Play()
		end
	end

	ToggleUpdaters[settingKey] = updateState
	updateState(true)

	Row.MouseButton1Click:Connect(function()
		Settings[settingKey] = not Settings[settingKey]
		updateState(false)
		if onChanged then onChanged(Settings[settingKey]) end
	end)
end

local function setSettingState(settingKey, value)
	if Settings[settingKey] == value then return end
	Settings[settingKey] = value
	if ToggleUpdaters[settingKey] then
		ToggleUpdaters[settingKey](false)
	end
end

