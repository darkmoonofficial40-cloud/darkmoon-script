    local transparency=0
    sliderRow(settingsRight,1,"Window Transparency",0,50,0,"%",function(v)
        transparency=v/100
        window.BackgroundTransparency=transparency
    end)

    sliderRow(settingsRight,2,"UI Scale",50,125,100,"%",function(v)
        baseScale=v/100
        scale.Scale=baseScale
    end)

    buttonRow(settingsRight,3,"RESET APPEARANCE",C.row,function()
        window.BackgroundTransparency=0
        transparency=0
        baseScale=1
        scale.Scale=baseScale
        setStatus("APPEARANCE RESET")
    end)

    buttonRow(settingsRight,4,"UNLOAD SCRIPT",C.ACCENT,function()
        for _,t in ipairs(allToggles) do
            if t.state then
                pcall(function() t.Set(false) end)
            end
        end
        stopFly()
        antiFlingOn=false
        antiVoidOn=false
        restoreAntiFlingCollisions()
        destroyWaterPart()
        aimbotOn=false
        aimlockOn=false
        fovCircleOn=false
        workspace.Gravity=origGravity
        clearHighlights()
        clearBoxEsp()
        clearHealthBars()
        clearTracers()
        clearNameEsp()
        clearFovCircle()
        gui:Destroy()
    end)

    -- MENU CONTROLS & QUICK PILL DRAG*
    local isOpen=true
    local minimized=false
    local animToken=0

    local function setOpen(v)
        if isOpen==v then return end
        isOpen=v
        animToken=animToken+1
        local token=animToken

        if v then
            window.Visible=true
            scale.Scale=baseScale*0.92
            TweenService:Create(scale,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
                Scale=baseScale
            }):Play()
        else
            tween(scale,0.15,{Scale=baseScale*0.92})
            task.delay(0.15,function()
                if animToken==token then window.Visible=false end
            end)
        end
    end

    local qbDragging,qbMoved,qbStart,qbPos
    quickBtn.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            qbDragging=true
            qbMoved=false
            qbStart=input.Position
            qbPos=quickBtn.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if qbDragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local delta=input.Position-qbStart
            if delta.Magnitude>5 then qbMoved=true end
            quickBtn.Position=UDim2.new(qbPos.X.Scale,qbPos.X.Offset+delta.X,qbPos.Y.Scale,qbPos.Y.Offset+delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            if qbDragging and not qbMoved then
                setOpen(not isOpen)
            end
            qbDragging=false
        end
    end)

    local function setMinimized(v)
        minimized=v
        content.Visible=not v
        sidebar.Visible=not v
        status.Visible=not v
        tween(window,0.2,{
            Size=v and UDim2.fromOffset(WIN_W,64) or UDim2.fromOffset(WIN_W,WIN_H)
        })
    end

    minBtn.MouseButton1Click:Connect(function()
        setMinimized(not minimized)
    end)

    closeBtn.MouseButton1Click:Connect(function()
        setOpen(false)
    end)

    searchBox:GetPropertyChangedSignal("Text"):Connect(applySearchFilter)

    UIS.InputBegan:Connect(function(input,processed)
        if input.KeyCode==Enum.KeyCode.RightShift then
            setOpen(not isOpen)
            return
        end
        if processed then return end

        if clickTpOn and input.UserInputType==Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            local cam=workspace.CurrentCamera
            local char,root=getChar()
            if cam and root then
                local mousePos=UIS:GetMouseLocation()
                local ray=cam:ViewportPointToRay(mousePos.X,mousePos.Y)
                local rayParams=RaycastParams.new()
                rayParams.FilterType=Enum.RaycastFilterType.Exclude
                if char then rayParams.FilterDescendantsInstances={char} end
                local hit=workspace:Raycast(ray.Origin,ray.Direction*1000,rayParams)
                if hit then
                    root.CFrame=CFrame.new(hit.Position+Vector3.new(0,3.5,0))
                    setStatus("CLICK TELEPORTED")
                end
            end
            return
        end

        if input.KeyCode==Enum.KeyCode.Q then
            triggerAirDash()
            return
        end

        local obj=binds[input.KeyCode]
        if obj then obj.Toggle() end
    end)

    player.CharacterAdded:Connect(function()
        antiFlingCache={}
        lastSafeCFrame=nil
        stopFly()
        if flyToggle then flyToggle.Set(false,true) end
        if hipOn then
            task.wait(0.5)
            local _,_,hum=getChar()
            if hum then origHip=hum.HipHeight end
        end
    end)

    local hudTimer=0
    RunService.RenderStepped:Connect(function(dt)
        stepWalkOnWater()
        updateBoxAndHealthEsp()
        updateTracers()
        updateNameEsp()
        updateFovCircle()

        if fpsHudOn then
            hudTimer=hudTimer+(dt or 0.016)
            if hudTimer>=0.35 then
                hudTimer=0
                local fps=math.floor(1/math.max(dt or 0.016,0.001)+0.5)
                local ping=0
                pcall(function()
                    ping=math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()+0.5)
                end)
                hudLabel.Text=string.format("FPS: %d | PING: %dms",fps,ping)
            end
        end

        if aimlockOn then
            local part=getClosestTargetPart()
            if part then aimCameraAt(part,1) end
        elseif aimbotOn and rmbHeld then
            local part=getClosestTargetPart()
            if part then
                local alpha=math.clamp((dt or 0.016)*(22-aimbotSmoothness),0.05,1)
                aimCameraAt(part,alpha)
            end
        end
        if fullbrightOn then
            Lighting.Brightness=2
            Lighting.ClockTime=14
            Lighting.FogEnd=1000000
            Lighting.GlobalShadows=false
            Lighting.Ambient=Color3.fromRGB(190,190,190)
            Lighting.OutdoorAmbient=Color3.fromRGB(190,190,190)
        end
        if fovOn then
            workspace.CurrentCamera.FieldOfView=fovValue
        end
    end)

    showPage("Movement")
    refreshPlayers()
    setStatus("READY | RIGHT SHIFT OR [DM]: MENU")
    notify("DARK MOON V 1.2 Loaded!")
    print("DARK MOON V 1.2 LOADED | BY BIYXZND")
    print("DISCORD: "..DISCORD_INVITE)
    print("RIGHT SHIFT / [DM] = MENU | B = SPEED | N = JUMP | J = INF JUMP | F = SPIDER FLY | Q = DASH")
end

