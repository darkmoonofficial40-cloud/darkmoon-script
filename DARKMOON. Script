-- ============================================
-- MakeDraggable (retorna true se está arrastando OU acabou de arrastar)
-- ============================================
local function MakeDraggable(obj)
	local dragging, moved = false, false
	local dragInput, dragStart, startPos

	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = obj.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	obj.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then moved = true end
			if moved then
				obj.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end
	end)

	return function() return dragging or moved end
end

-- Botão neon quadrado arrastável (usado por Shoot / Double Jump / DJ+Shoot)
local function CreateNeonButton(gui, o)
	local Button = Instance.new("TextButton")
	Button.Name = o.Name
	Button.Size = UDim2.new(0, 70, 0, 70)
	Button.Position = o.Position
	Button.BackgroundColor3 = o.Bg
	Button.BorderSizePixel = 0
	Button.Font = Enum.Font.GothamBold
	Button.Text = o.Text
	Button.TextColor3 = o.Accent
	Button.TextSize = o.TextSize or 14
	Button.AutoButtonColor = false
	Button.Parent = gui

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 12)
	Corner.Parent = Button

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = o.Accent
	Stroke.Thickness = 2.5
	Stroke.Transparency = 0.3
	Stroke.Parent = Button

	local light = o.Bg:Lerp(Color3.new(1, 1, 1), 0.06)
	local Gradient = Instance.new("UIGradient")
	Gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, light),
		ColorSequenceKeypoint.new(0.5, o.Bg),
		ColorSequenceKeypoint.new(1, light),
	}
	Gradient.Rotation = 90
	Gradient.Parent = Button

	local isDragging = MakeDraggable(Button)
	local originalSize = Button.Size
	local hoverSize = UDim2.new(0, 76, 0, 76)
	local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local hoverBg = o.Bg:Lerp(Color3.new(1, 1, 1), 0.08)
	local hoverText = o.Accent:Lerp(Color3.new(1, 1, 1), 0.4)

	Button.MouseEnter:Connect(function()
		if not isDragging() then
			TweenService:Create(Button, info, {Size = hoverSize, TextColor3 = hoverText, BackgroundColor3 = hoverBg}):Play()
			TweenService:Create(Stroke, info, {Transparency = 0, Thickness = 3.5}):Play()
		end
	end)
	Button.MouseLeave:Connect(function()
		TweenService:Create(Button, info, {Size = originalSize, TextColor3 = o.Accent, BackgroundColor3 = o.Bg}):Play()
		TweenService:Create(Stroke, info, {Transparency = 0.3, Thickness = 2.5}):Play()
	end)

	return Button, isDragging
end

