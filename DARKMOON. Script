			cardEntry.AvStroke.Color = color
			cardEntry.Stroke.Color = (role == "Murderer") and color or Theme.BorderSoft
			cardEntry.RoleBadge.TextColor3 = color
			if not isAlive then
				cardEntry.RoleBadge.Text = role .. " • DEAD"
			elseif player == LocalPlayer or not myRoot then
				cardEntry.RoleBadge.Text = role
			else
				local dist = math.floor((hrp.Position - myRoot.Position).Magnitude)
				cardEntry.RoleBadge.Text = role .. " [" .. dist .. "m]"
			end
			if cardEntry.TpBtn then
				cardEntry.TpBtn.Active = isAlive and not isFlinging
				cardEntry.TpBtn.BackgroundTransparency = (isAlive and not isFlinging) and 0 or 0.55
			end
			if cardEntry.FlingBtn then
				cardEntry.FlingBtn.Active = isAlive and not isFlinging
				cardEntry.FlingBtn.BackgroundTransparency = (isAlive and not isFlinging) and 0 or 0.55
			end
		end

		if player == LocalPlayer then continue end

		local v = getVisuals(player)
		if isAlive then
			if Settings.RoleHighlightESP and char then
				v.CharHighlight.Adornee = char
				v.CharHighlight.FillColor = color
				v.CharHighlight.OutlineColor = color
				v.CharHighlight.Enabled = true
			else
				v.CharHighlight.Enabled = false
			end

			local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
			if onScreen then
				local top = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.5, 0))
				local bottom = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
				local h = math.max(12, math.abs(bottom.Y - top.Y))
				local w = h * 0.65
				local left = pos.X - (w * 0.5)
				local topY = pos.Y - (h * 0.5)

				if Settings.RoleBoxESP then
					v.Box.Size = UDim2.new(0, w, 0, h)
					v.Box.Position = UDim2.new(0, left, 0, topY)
					v.Stroke.Color = color
					v.Box.Visible = true
				else
					v.Box.Visible = false
				end

				if Settings.RoleNameESP then
					local dist = myRoot and (" [" .. math.floor((hrp.Position - myRoot.Position).Magnitude) .. "m]") or ""
					v.Tag.Position = UDim2.new(0, pos.X, 0, topY - 3)
					v.Tag.TextColor3 = color
					v.Tag.Text = player.Name .. " • " .. role .. dist
					v.Tag.Visible = true
				else
					v.Tag.Visible = false
				end

				if Settings.RoleTracerESP then
					local targetPt = Vector2.new(pos.X, pos.Y)
					local delta = targetPt - bottomCenter
					local mid = (targetPt + bottomCenter) * 0.5
					v.Tracer.Size = UDim2.new(0, delta.Magnitude, 0, 1.5)
					v.Tracer.Position = UDim2.new(0, mid.X, 0, mid.Y)
					v.Tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					v.Tracer.BackgroundColor3 = color
					v.Tracer.BackgroundTransparency = 0.25
					v.Tracer.Visible = true
				else
					v.Tracer.Visible = false
				end
			else
				v.Box.Visible = false
				v.Tag.Visible = false
				v.Tracer.Visible = false
			end
		else
			v.Box.Visible = false
			v.Tag.Visible = false
			v.Tracer.Visible = false
			v.CharHighlight.Enabled = false
		end
	end

	-- Aimbot & Silent Aim Target Indicator
	local aimActive = Settings.Aimbot or Settings.SilentAim
	local aimPart, aimRole = nil, nil
	if aimActive then
		aimPart, aimRole = selectBestAimTarget()
	end

	if aimPart then
		local predictedWorld = getPredictedAimPos(aimPart)
		local screenPt, onScreen = Camera:WorldToViewportPoint(predictedWorld)
		local indColor = RoleColors[aimRole] or Theme.MoonGlow

		if Settings.ShowTargetIndicator and onScreen then
			TargetIndicator.Position = UDim2.new(0, screenPt.X, 0, screenPt.Y)
			IndicatorStroke.Color = indColor
			IndicatorDot.BackgroundColor3 = indColor
			TargetIndicator.Visible = true
		else
			TargetIndicator.Visible = false
		end

		local shouldLockCamera = Settings.Aimbot and (isRightClickAiming or (isPrimaryFiring and UserInputService.TouchEnabled))
		if shouldLockCamera then
			local camPos = Camera.CFrame.Position
			local targetCFrame = CFrame.lookAt(camPos, predictedWorld)
			local alpha = 1 - math.exp(-math.clamp(Settings.AimSmoothness, 0.05, 1) * 28 * math.min(dt or 0.016, 0.05))
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
		end
	else
		TargetIndicator.Visible = false
	end
end)

-- Reliable Auto Pickup Gun Loop
task.spawn(function()
	while task.wait(0.1) do
		if isFlinging or isKillingAll or not Settings.AutoPickupGun then continue end
		if alreadyOwnsGun() then continue end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then continue end

		local gunObj, gunPart, prompt = getDroppedGunTarget()
		if gunObj and gunPart and gunPart.Parent then
			local savedCFrame = hrp.CFrame
			teleportToCFrame(CFrame.new(gunPart.Position + Vector3.new(0, 1, 0)))
			triggerGunTouch(hrp, gunPart)

			if prompt and prompt.Parent then
				pcall(function()
					if typeof(fireproximityprompt) == "function" then
						fireproximityprompt(prompt)
					else
						prompt:InputHoldBegin()
						task.wait(0.05)
						prompt:InputHoldEnd()
					end
				end)
			end

			task.wait(0.08)
			if alreadyOwnsGun() and hrp and hrp.Parent then
				teleportToCFrame(savedCFrame + Vector3.new(0, 1.5, 0))
			end
		end
	end
end)
