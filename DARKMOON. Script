local _roleDataCache = {}
local _roleDataLastUpdate = 0
local _getPlayerDataRemote = nil

local function GetPlayerRoleData()
	local now = tick()
	if now - _roleDataLastUpdate < 1 then
		return _roleDataCache
	end
	_roleDataLastUpdate = now
	if not _getPlayerDataRemote then
		_getPlayerDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	end
	if _getPlayerDataRemote then
		local ok, data = pcall(function() return _getPlayerDataRemote:InvokeServer() end)
		if ok and type(data) == "table" then
			_roleDataCache = data
		end
	end
	return _roleDataCache
end

local function GetPlayerByRole(roleName)
	local data = GetPlayerRoleData()
	for name, info in pairs(data) do
		if info.Role == roleName and not info.Killed and not info.Dead then
			return Players:FindFirstChild(name)
		end
	end
	return nil
end

local function GetMurderer()
	return GetPlayerByRole("Murderer")
end

local function GetColorFromRole(player, roleData)
	local role, isDead = nil, false
	for name, info in pairs(roleData) do
		if player.Name == name then
			role = info.Role
			if info.Killed or info.Dead then isDead = true end
			break
		end
	end
	if isDead then return Color3.fromRGB(80, 80, 80) end
	if role == "Murderer" then return Color3.fromRGB(255, 0, 0) end
	if role == "Sheriff" then return Color3.fromRGB(0, 0, 255) end
	if role == "Hero" then return Color3.fromRGB(255, 255, 0) end
	return Color3.fromRGB(0, 255, 0)
end

