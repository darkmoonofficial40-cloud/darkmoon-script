    local function showPage(name)
        for _, p in pairs(pages) do p.Visible = false end
        pages[name].Visible = true
        for n, b in pairs(navBtns) do
            local on = n == name
            b.BackgroundColor3 = on and Color3.fromRGB(32, 28, 58) or Color3.fromRGB(9, 10, 19)
