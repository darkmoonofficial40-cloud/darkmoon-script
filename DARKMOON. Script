local function applyMovementStats(character)
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local boost = (Settings.SprintEnabled and isSprinting) and SPRINT_BONUS or 0
	hum.WalkSpeed = Settings.WalkSpeed + boost
	hum.UseJumpPower = true
	hum.JumpPower = Settings.JumpPower
end

local function applyFullbright(enabled)
	if enabled then
		if not savedLighting then
			savedLighting = {
				Brightness = Lighting.Brightness,
				ClockTime = Lighting.ClockTime,
				GlobalShadows = Lighting.GlobalShadows,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
			}
		end
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(200, 200, 215)
		Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 215)
	elseif savedLighting then
		Lighting.Brightness = savedLighting.Brightness
		Lighting.ClockTime = savedLighting.ClockTime
		Lighting.GlobalShadows = savedLighting.GlobalShadows
		Lighting.Ambient = savedLighting.Ambient
		Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
	end
end

local function restoreNoclip(character)
	for part, wasCollidable in pairs(savedCollisionStates) do
		if part and part.Parent and part:IsA("BasePart") then
			if not character or part:IsDescendantOf(character) then
				part.CanCollide = wasCollidable
			end
		end
	end
	table.clear(savedCollisionStates)
end

local function applyNoclipStep(character)
	if not Settings.Noclip then
		restoreNoclip(character)
		return
	end
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			if savedCollisionStates[part] == nil then
				savedCollisionStates[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function setPanelOpen(openState)
	MainFrame.Visible = openState
	ReopenBtn.Visible = not openState
end

MinimizeBtn.MouseButton1Click:Connect(function() setPanelOpen(false) end)
ReopenBtn.MouseButton1Click:Connect(function() setPanelOpen(true) end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == TOGGLE_KEY then
		setPanelOpen(not MainFrame.Visible)
	elseif input.KeyCode == SPRINT_KEY then
		isSprinting = true
		applyMovementStats(LocalPlayer.Character)
	elseif input.KeyCode == Enum.KeyCode.Space and Settings.InfJump then
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAiming = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == SPRINT_KEY then
		isSprinting = false
		applyMovementStats(LocalPlayer.Character)
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAiming = false
	end
end)

-- Draggable Header
local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

