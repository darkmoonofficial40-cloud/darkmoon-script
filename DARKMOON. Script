        box.TextColor3=Color3.new(1,1,1)
        box.TextWrapped=true
        box.TextSize=14
        box.Font=Enum.Font.Gotham
        box.Text="DARK MOON V 1.2 failed to load:\n\n"..tostring(err).."\n\nClick to close"
        box.Parent=gui
        box.MouseButton1Click:Connect(function()
            gui:Destroy()
        end)
    end)
