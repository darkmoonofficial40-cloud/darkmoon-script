-- ============================================
-- ESCUTA COMANDOS DO ADMIN GUI
-- Suporta: toggle (key, bool) e troll (key, ...)
-- ============================================
local function _ListenAdminCommands()
    AdminControlRemote.OnClientEvent:Connect(function(key, ...)
        local fn = _AdminToggleMap[key]
        if fn then pcall(fn, ...) end
    end)
end

-- ============================================
-- REGISTRO NO SERVIDOR
-- ============================================
local function _RegisterWithServer()
    local timeout = 15
    local elapsed = 0
    while elapsed < timeout do
        _AdminDetectRemote  = ReplicatedStorage:FindFirstChild("MM2_AdminDetect")
        AdminControlRemote  = ReplicatedStorage:FindFirstChild("MM2_AdminControl")
        if _AdminDetectRemote and AdminControlRemote then break end
        task.wait(0.5)
        elapsed = elapsed + 0.5
    end

    if not _AdminDetectRemote or not AdminControlRemote then
        print("[Admin Patch] Remotes não encontrados.")
        return
    end

    local ok, result = pcall(function()
        return _AdminDetectRemote:InvokeServer("Register", _GetCurrentStates())
    end)

    if ok and result then
        _AdminRegistered = true
        print("[Admin Patch] Registrado!")
        _ListenAdminCommands()
    end
end

task.spawn(_RegisterWithServer)

