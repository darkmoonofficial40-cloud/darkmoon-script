    -- ============================================
    -- MAIN LOOP
    -- ============================================
    local espT = 0; local farmT = 0; local listT = 0; local gunCheckT = 0
    local sheriffWasAlive = isSheriffAlive()
    local autoGunBusy = false

    RunService.RenderStepped:Connect(function(dt)
        local char = getChar(); if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        -- FLY
        if states.fly and flyBV and flyBG and hrp and hum then
            local cf = Camera.CFrame
            local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local rgt = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            if fwd.Magnitude > 0 then fwd = fwd.Unit end
            if rgt.Magnitude > 0 then rgt = rgt.Unit end
            flyBG.CFrame = CFrame.new(hrp.Position, hrp.Position + fwd)
            local vel = Vector3.zero; local spd = states.flySpeed
            if UserInputService.TouchEnabled and hum.MoveDirection.Magnitude > 0 then
                local md = hum.MoveDirection; vel = vel + Vector3.new(md.X, 0, md.Z).Unit * spd
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + fwd * spd end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - fwd * spd end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - rgt * spd end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + rgt * spd end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or mobileUp then vel = vel + Vector3.new(0, spd, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or mobileDown then vel = vel - Vector3.new(0, spd, 0) end
            flyBV.Velocity = vel
        end

        -- NOCLIP
        if states.noclip and hrp then
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
            end
        end

        -- ANTI-SIT
        if states.antiSit and hum then
            if hum.Sit then hum.Sit = false end
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("Weld") and v.Name == "SeatWeld" then v:Destroy() end
            end
        end

        -- NIGHT VISION
        Lighting.Ambient = states.nightVision and Color3.new(1, 1, 1) or Color3.fromRGB(90, 85, 100)

        -- 360 SPIN
        if states.spin and hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(45), 0) end

        -- ESP
        espT = espT + dt
        if espT >= 0.12 then
            espT = 0
            if states.esp or states.espMurderer or states.espSheriff or states.espInnocent or states.espWeapon then
                updateESP()
            end
        end

        -- COIN & GEM FARM
        farmT = farmT + dt
        if farmT >= 0.25 then
            farmT = 0
            if (states.coinFarm or states.gemFarm) and hrp then
                local origin = hrp.CFrame
                local collectedCoin = false

                if states.coinFarm then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local nm = obj.Name:lower(); local match = false
                            for _, cn in ipairs(COIN_NAMES) do if nm == cn or nm:find(cn) then match = true; break end end
                            if match and obj.Parent ~= char and (origin.Position - obj.Position).Magnitude < 250 then
                                hrp.CFrame = obj.CFrame
                                coinCount = coinCount + 1
                                collectedCoin = true
                                if coinCV and coinCV.Parent then coinCV.Text = coinCount .. " coins" end
                                break
                            end
                        end
                    end
                end

                if states.gemFarm then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local nm = obj.Name:lower(); local match = false
                            for _, gn in ipairs(GEM_NAMES) do if nm == gn or nm:find(gn) then match = true; break end end
                            if match and obj.Parent ~= char and (origin.Position - obj.Position).Magnitude < 250 then
                                hrp.CFrame = obj.CFrame
                                collectedCoin = true
                                break
                            end
                        end
                    end
                end

                if collectedCoin then
                    task.delay(0.06, function()
                        local curHRP = getHRP()
                        if curHRP and not states.fly then
                            curHRP.CFrame = origin
                        end
                    end)
                end
            end
        end

        -- AUTO GUN
        gunCheckT = gunCheckT + dt
        if gunCheckT >= 0.5 then
            gunCheckT = 0
            if states.autoGun and hrp and not autoGunBusy then
                local sheriffNowAlive = isSheriffAlive()
                if sheriffWasAlive and not sheriffNowAlive then
                    autoGunBusy = true
                    task.spawn(function()
                        task.wait(0.3)
                        local picked = false
                        for _ = 1, 4 do
                            local gun = findDroppedGun()
                            local curHRP = getHRP()
                            if not gun or not curHRP then break end
                            local handle = gun:FindFirstChild("Handle")
                            local targetPos = handle and handle.Position or gun:GetPivot().Position
                            curHRP.CFrame = CFrame.new(targetPos)
                            picked = true
                            task.wait(0.15)
                        end
                        if picked and agStatusVal and agStatusVal.Parent then
                            agStatusVal.Text = "Grabbed Gun ✓"
                            agStatusVal.TextColor3 = C.green
                            task.wait(2)
                            if agStatusVal and agStatusVal.Parent and states.autoGun then
                                agStatusVal.Text = "Active"
                                agStatusVal.TextColor3 = C.green
                            end
                        end
                        autoGunBusy = false
                    end)
                end
                sheriffWasAlive = sheriffNowAlive
            end
        end

        -- PLAYER LIST REFRESH
        listT = listT + dt
        if listT >= 2.5 then
            listT = 0
            for _, btn in ipairs(PList:GetChildren()) do
                if btn:IsA("TextButton") then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and btn.Text:find(p.DisplayName, 1, true) then
                            local role = getRoleByTool(p)
                            btn.Text = (ROLE_ICONS[role] or "👤") .. "  " .. p.DisplayName
                            btn.TextColor3 = ROLE_COLORS[role] or C.text
                        end
                    end
                end
            end
        end
    end)

    -- INFINITE JUMP
    UserInputService.JumpRequest:Connect(function()
        if states.infJump then local h = getHum(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end
    end)

    -- CHARACTER RESPAWN
    LocalPlayer.CharacterAdded:Connect(function()
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end
        states.fly = false; mobileUp = false; mobileDown = false
        if flyMF then flyMF.Visible = false end
        task.wait(0.8)
        applyMovementModifiers()
        sheriffWasAlive = isSheriffAlive()
        task.wait(0.4)
        if states.esp or states.espMurderer or states.espSheriff or states.espInnocent then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then createESP(p) end
            end
        end
    end)
end

