    local function applySearchFilter()
        local q=searchBox.Text:lower():match("^%s*(.-)%s*$")
        if q=="" then
            for _,entry in ipairs(searchableRows) do
                entry.row.Visible=true
            end
            for n,p in pairs(pages) do
                p.Visible=(n==activePage)
            end
            return
        end

        local pageMatches={}
        for _,entry in ipairs(searchableRows) do
            local matched=entry.text:find(q,1,true)~=nil
            entry.row.Visible=matched
            if matched and entry.pageName then
                pageMatches[entry.pageName]=true
            end
        end

        for n,p in pairs(pages) do
            p.Visible=(pageMatches[n]==true)
        end
    end

    local function registerSearchable(row,pageName,extraTexts)
        local parts={}
        for _,desc in ipairs(row:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                if desc.Text and desc.Text~="" then
                    table.insert(parts,desc.Text)
                end
            end
        end
        for _,t in ipairs(extraTexts or {}) do
            if t and t~="" then
                table.insert(parts,t)
            end
        end
        table.insert(searchableRows,{
            row=row,
            pageName=pageName,
            text=table.concat(parts," "):lower()
        })
    end

    local function showPage(name)
        activePage=name
        local q=searchBox.Text:lower():match("^%s*(.-)%s*$")
        if q~="" then
            searchBox.Text=""
            return
        end

        for n,p in pairs(pages) do p.Visible=(n==name) end
        for n,t in pairs(tabs) do
            local active=n==name
            t.btn.BackgroundColor3=active and C.row or C.side
            t.btn.TextColor3=active and C.text or C.sub
            t.bar.Visible=active
        end
    end

