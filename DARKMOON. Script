-- Modo de alvo: "Murderer" ou "KnifeHolder"
local TargetMode = "Murderer"

-- Retorna o player que tem a Knife (no char ou no backpack)
local function GetKnifeHolder()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			-- Knife equipada no personagem
			if p.Character:FindFirstChild("Knife") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					return p
				end
			end
			-- Knife no Backpack (guardada)
			local bp = p:FindFirstChild("Backpack")
			if bp and bp:FindFirstChild("Knife") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					return p
				end
			end
		end
	end
	return nil
end

-- Retorna o alvo atual de acordo com o modo selecionado
local function GetCurrentTarget()
	if TargetMode == "KnifeHolder" then
		return GetKnifeHolder()
	end
	return GetMurderer()
end

