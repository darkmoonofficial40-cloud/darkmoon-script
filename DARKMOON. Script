-- ── Murderer ────────────────────────────────
local function FindMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char    = p.Character
            local backpack = p:FindFirstChild("Backpack")
            local hasKnife = (char and char:FindFirstChild("Knife"))
                          or (backpack and backpack:FindFirstChild("Knife"))
            if hasKnife then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then return root end
            end
        end
    end
    return nil
end

local function IsCoinDangerous(coinPosition)
    if not AvoidMurderCoinsEnabled then return false end
    local murdererRoot = FindMurderer()
    if not murdererRoot then return false end
    local mPos = murdererRoot.Position

    if (mPos - coinPosition).Magnitude <= 40 then return true end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then
        local myPos  = myRoot.Position
        local toCoin = coinPosition - myPos
        local coinDist = toCoin.Magnitude
        if coinDist > 0 then
            local dir  = toCoin.Unit
            local proj = (mPos - myPos):Dot(dir)
            if proj > 0 and proj < coinDist then
                local closest  = myPos + dir * proj
                local perpDist = (mPos - closest).Magnitude
                if perpDist <= 15 then return true end
            end
        end
    end
    return false
end

local function FindFarthestPlayer()
    local farthest, longestDist = nil, 0
    local murdererRoot = FindMurderer()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local otherRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local isMurderer = murdererRoot and otherRoot == murdererRoot
            if otherRoot and not isMurderer then
                local dist = (otherRoot.Position - myRoot.Position).Magnitude
                if dist <= 100 and dist > longestDist then
                    farthest    = otherRoot
                    longestDist = dist
                end
            end
        end
    end
    return farthest
end

local function CheckMurdererNearMe()
    if not AntiMurderEnabled then
        currentSpeed = normalSpeed
        return
    end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local murdererRoot = FindMurderer()
    if murdererRoot then
        local dist = (murdererRoot.Position - myRoot.Position).Magnitude
        if dist <= 30 then
            local farthest = FindFarthestPlayer()
            if farthest then
                myRoot.CFrame = farthest.CFrame + Vector3.new(0, 5, 0)
                currentSpeed  = normalSpeed
            else
                currentSpeed  = escapeSpeed
            end
        else
            currentSpeed = normalSpeed
        end
    else
        currentSpeed = normalSpeed
    end
end

-- ── Busca moeda mais próxima (usa cache) ────
local function FindNearestCoin()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos = myRoot.Position

    local nearest, shortestDist = nil, 150

    for coin, _ in pairs(_coinCache) do
        -- Valida se a instância ainda existe no workspace
        if coin and coin.Parent and not collectedCoins[coin] then
            local dist = (coin.Position - myPos).Magnitude
            if dist <= 150 and dist < shortestDist then
                if not IsCoinDangerous(coin.Position) then
                    nearest      = coin
                    shortestDist = dist
                end
            end
        else
            -- Remove entradas mortas do cache
            _coinCache[coin] = nil
        end
    end
    return nearest
end

-- ── Farm de uma moeda ───────────────────────
-- Retorna true se coletou, false se abortou
local function FarmCoin(coin)
    if not coin or not coin.Parent then return false end

    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    -- Marca como sendo processada ANTES do tween
    -- para evitar que outro ciclo tente pegar a mesma moeda
    collectedCoins[coin] = true

    SetNoclip(true)
    Workspace.Gravity = 0
    CheckMurdererNearMe()

    local dist         = (coin.Position - root.Position).Magnitude
    local timeToTravel = math.max(dist / math.max(currentSpeed, 1), 0.05)
    local tweenInfo    = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local goal         = { CFrame = CFrame.new(coin.Position) }

    currentTween = TweenService:Create(root, tweenInfo, goal)

    -- Monitora se a moeda sumiu durante o trajeto
    local coinGone      = false
    local coinRemoving  = coin.AncestryChanged:Connect(function(_, parent)
        if not parent then
            coinGone = true
            if currentTween then currentTween:Cancel() end
        end
    end)

    currentTween:Play()

    -- Aguarda conclusão com timeout de segurança
    local timeout   = timeToTravel + 1.0
    local startTime = tick()
    local completed = false

    local doneConn = currentTween.Completed:Connect(function()
        completed = true
    end)

    while not completed and not coinGone and AutoFarmEnabled do
        if tick() - startTime > timeout then
            -- Timeout: cancela e desmarca para tentar de novo depois
            if currentTween then currentTween:Cancel() end
            collectedCoins[coin] = nil
            break
        end
        CheckMurdererNearMe()
        RunService.Heartbeat:Wait()
    end

    doneConn:Disconnect()
    coinRemoving:Disconnect()
    currentTween = nil

    SetNoclip(false)
    Workspace.Gravity = originalGravity

    return completed or coinGone
end

-- ── Loop principal ──────────────────────────
local function StartFarmLoop()
    farmLoop = task.spawn(function()
        while AutoFarmEnabled do
            -- pcall envolve tudo: qualquer erro interno não mata o loop
            local ok, err = pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.5)
                    return
                end

                -- Garante que o cache esteja pronto
                if not _coinCacheReady then
                    task.wait(0.2)
                    return
                end

                CheckMurdererNearMe()
                local coin = FindNearestCoin()

                if coin then
                    FarmCoin(coin)
                else
                    -- Sem moedas visíveis: aguarda um pouco antes de varrer de novo
                    task.wait(0.5)
                end
            end)

            if not ok then
                warn("[AutoFarm] Erro no loop: " .. tostring(err))
                task.wait(0.5)  -- aguarda antes de reiniciar após erro
            end

            -- Yield mínimo para não travar o scheduler
            task.wait(0.05)
        end

        -- Cleanup ao sair do loop
        if currentTween then currentTween:Cancel() currentTween = nil end
        SetNoclip(false)
        Workspace.Gravity = originalGravity
    end)
end

