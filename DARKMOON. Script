									if not AutoThrowEnabled then return end
									local targetCF = closest.Character
										and closest.Character:FindFirstChild("HumanoidRootPart")
										and closest.Character.HumanoidRootPart.CFrame
									if targetCF then
										remote:FireServer(CFrame.lookAt(myRoot.Position, targetCF.Position), targetCF)
									end
									PlayKnifeAnim("ThrowKnife")
								end
							end
						end
					end
				end)
				task.wait(0.5)
			end
		end)
	end
end, "AutoThrow")

