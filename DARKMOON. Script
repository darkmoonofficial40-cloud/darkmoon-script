local function styleSidebarButton(btn, isSelected)
	if isSelected then
		btn.BackgroundColor3 = Color3.fromRGB(28, 48, 175)
		btn.BackgroundTransparency = 0
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
