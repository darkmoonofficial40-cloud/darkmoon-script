local function findPlayerTool(player)
    if not player or not player.Parent then return nil end
    local char = player.Character
    if char then
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then return equipped end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                for _, s in ipairs(SHERIFF_PATTERNS) do
                    if n:find(s) then return item end
                end
                for _, k in ipairs(KNIFE_PATTERNS) do
                    if n:find(k) then return item end
                end
            end
        end
        return bp:FindFirstChildOfClass("Tool")
    end
    return nil
end

local function getRoleByTool(player)
    local tool = findPlayerTool(player)
    if not tool then return "innocent" end

    local tn = tool.Name:lower()

    for _, s in ipairs(SHERIFF_PATTERNS) do
        if tn:find(s) then return "sheriff" end
    end

    for _, k in ipairs(KNIFE_PATTERNS) do
        if tn:find(k) then return "murderer" end
    end

    return "innocent"
end

