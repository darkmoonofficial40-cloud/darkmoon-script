		local params           = RaycastParams.new()
		params.FilterType      = Enum.RaycastFilterType.Exclude

		AutoThrowLoop = task.spawn(function()
			while AutoThrowEnabled do
				pcall(function()
					local char = LocalPlayer.Character
					if char and char:FindFirstChild("Knife") and char.Knife:FindFirstChild("Events") then
						local closest, closestMag = nil, 100
						local myRootPos           = char.HumanoidRootPart.Position
						for _, p in pairs(Players:GetPlayers()) do
							if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
								local hum = p.Character:FindFirstChild("Humanoid")
								if hum and hum.Health > 0 then
									local dist = (myRootPos - p.Character.HumanoidRootPart.Position).Magnitude
									if dist < closestMag then closest = p closestMag = dist end
								end
							end
						end
						if closest then
							local myRoot     = char.HumanoidRootPart
							local targetRoot = closest.Character.HumanoidRootPart
							params.FilterDescendantsInstances = { char }
							local ray    = Workspace:Raycast(myRoot.Position, targetRoot.Position - myRoot.Position, params)
							local canHit = (ray and ray.Instance and ray.Instance:IsDescendantOf(closest.Character)) or (not ray)
							if canHit then
								local remote = char.Knife.Events:FindFirstChild("KnifeThrown") or char.Knife.Events:FindFirstChild("Throw")
