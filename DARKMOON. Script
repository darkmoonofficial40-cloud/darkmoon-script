local KnifeAimEnabled = false
local oldNamecall

local function GetClosestToMouse()
	local mPos   = UserInputService:GetMouseLocation()
	local c, dist = nil, math.huge
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local v, on = Workspace.CurrentCamera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
			if on then
				local d = (Vector2.new(v.X, v.Y) - mPos).Magnitude
				if d < dist then dist = d c = p end
			end
		end
	end
	return c
end

local hookOk, hookErr = pcall(function()
	local hookFn = function(self, ...)
		local method = getnamecallmethod()

		if KnifeAimEnabled and method == "FireServer" and typeof(self) == "Instance" then
			local n = self.Name
			if n == "Throw" or n == "KnifeThrown" or n == "Stab" or n == "Slash" then
				local args   = table.pack(...)
				local target = GetClosestToMouse()
				if target and target.Character then
					local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
					if targetRoot then
						if n == "KnifeThrown" then
							args[2] = targetRoot.CFrame
						else
							args[1] = targetRoot.Position
						end
						if setnamecallmethod then setnamecallmethod(method) end
						return oldNamecall(self, table.unpack(args, 1, math.max(args.n, 2)))
					end
				end
			end
		end

		if setnamecallmethod then setnamecallmethod(method) end
		return oldNamecall(self, ...)
	end
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hookFn) or hookFn)
end)
if not hookOk then
	warn("[MM2 DarkUI] Knife Silent Aim hook indisponível neste executor: " .. tostring(hookErr))
end

CombatTab:Toggle("Knife Silent Aim", false, function(enabled)
	KnifeAimEnabled = enabled
	if enabled and not hookOk then
		Notify("Knife Silent Aim", "Seu executor não suporta hookmetamethod.")
	end
end, "KnifeAim")

