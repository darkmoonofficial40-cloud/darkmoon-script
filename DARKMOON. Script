-- ── Cache de moedas coletadas ───────────────
-- Usa WeakTable para moedas: quando a instância é destruída pelo
-- Roblox, a entrada some automaticamente sem precisar de cleanup manual.
local collectedCoins = setmetatable({}, { __mode = "k" })

-- ── Cache de moedas no workspace ───────────
-- Em vez de varrer GetDescendants() a cada frame, mantemos
-- uma tabela viva usando DescendantAdded/DescendantRemoving.
local _coinCache      = {}  -- { [coin] = true }
