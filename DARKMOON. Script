local firstTab = true
local function AddTab(enName, trName)
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.Position = UDim2.new(0, 0, 0, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = ThemeColor
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.Visible = firstTab
    Page.Parent = PagesFolder

    local PageList = Instance.new("UIListLayout", Page)
    PageList.Padding = UDim.new(0, 8)
    PageList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Instance.new("UIPadding", Page).PaddingTop = UDim.new(0, 12)

    PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 24)
    end)

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.92, 0, 0, 32)
    TabBtn.BackgroundColor3 = MoonColors.CardBg
    TabBtn.BorderSizePixel = 0
    TabBtn.Text = string.format("  ☽  %s", enName)
    TabBtn.TextColor3 = firstTab and ThemeColor or MoonColors.TextMuted
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.Parent = Sidebar
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 8)

    table.insert(C.TranslatedElements, {
        Type = "Tab",
        Button = TabBtn,
        EN = enName,
        TR = trName
    })

    TabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(PagesFolder:GetChildren()) do p.Visible = false end
        for _, b in pairs(Sidebar:GetChildren()) do
            if b:IsA("TextButton") then b.TextColor3 = MoonColors.TextMuted end
        end
        Page.Visible = true
        TabBtn.TextColor3 = ThemeColor
    end)

    firstTab = false

    local Tab = {}
    function Tab:AddToggle(enTitle, trTitle, default, callback)
        local state = default
        local TBtn = Instance.new("TextButton")
        TBtn.Size = UDim2.new(0.94, 0, 0, 38)
        TBtn.BackgroundColor3 = MoonColors.CardBg
        TBtn.BorderSizePixel = 0
        TBtn.Text = (state and "  [ON]  " or "  [OFF] ") .. enTitle
        TBtn.TextColor3 = state and ThemeColor or MoonColors.TextPrimary
        TBtn.Font = Enum.Font.GothamSemibold
        TBtn.TextSize = 11
        TBtn.TextXAlignment = Enum.TextXAlignment.Left
        TBtn.Parent = Page
        Instance.new("UICorner", TBtn).CornerRadius = UDim.new(0, 8)

        local Stroke = Instance.new("UIStroke", TBtn)
        Stroke.Color = state and ThemeColor or MoonColors.Border
        Stroke.Transparency = state and 0.25 or 0.5

        table.insert(C.TranslatedElements, {
            Type = "Toggle",
            Button = TBtn,
            GetState = function() return state end,
            EN = enTitle,
            TR = trTitle
        })

        TBtn.MouseButton1Click:Connect(function()
            state = not state
            local label = C.Language == "Turkish" and trTitle or enTitle
            TBtn.Text = (state and "  [ON]  " or "  [OFF] ") .. label
            TBtn.TextColor3 = state and ThemeColor or MoonColors.TextPrimary
            Stroke.Color = state and ThemeColor or MoonColors.Border
            Stroke.Transparency = state and 0.25 or 0.5
            pcall(callback, state)
        end)
    end

    function Tab:AddButton(enTitle, trTitle, callback)
        local BBtn = Instance.new("TextButton")
        BBtn.Size = UDim2.new(0.94, 0, 0, 38)
        BBtn.BackgroundColor3 = MoonColors.CardBg
        BBtn.BorderSizePixel = 0
        BBtn.Text = "  ◈  " .. enTitle
        BBtn.TextColor3 = Color3.fromRGB(190, 210, 255)
        BBtn.Font = Enum.Font.GothamSemibold
        BBtn.TextSize = 11
        BBtn.TextXAlignment = Enum.TextXAlignment.Left
        BBtn.Parent = Page
        Instance.new("UICorner", BBtn).CornerRadius = UDim.new(0, 8)

        local BStroke = Instance.new("UIStroke", BBtn)
        BStroke.Color = MoonColors.Border
        BStroke.Transparency = 0.45

        table.insert(C.TranslatedElements, {
            Type = "Button",
            Button = BBtn,
            EN = enTitle,
            TR = trTitle
        })

        BBtn.MouseButton1Click:Connect(function()
            pcall(callback)
        end)
    end

    return Tab
end

-- Helper to send chat safely across chat versions
local function sendChatNotification(msg)
    pcall(function()
        local legacyChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if legacyChat and legacyChat:FindFirstChild("SayMessageRequest") then
            legacyChat.SayMessageRequest:FireServer(msg, "All")
        elseif TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channels = TextChatService:FindFirstChild("TextChannels")
            local general = channels and channels:FindFirstChild("RBXGeneral")
            if general then
                general:SendAsync(msg)
            end
        end
    end)
end

