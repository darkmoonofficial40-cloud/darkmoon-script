-- ── Circle Aim: estado compartilhado ──────
local CircleAimEnabled   = false
local CircleAimGui       = nil
local CircleAimRadius    = 80        -- raio em pixels
local CircleAimCenter    = Vector2.new(0, 0)
local CircleAimConnection = nil

-- Retorna o jogador + distância 3D cujo root cai dentro do círculo da tela
local function GetPlayerInsideCircle()
	local char = LocalPlayer.Character
	if not char then return nil, math.huge end
	local myRoot = char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, math.huge end

	local camera               = Workspace.CurrentCamera
	local closest, closestDist = nil, math.huge

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
			local hum   = p.Character:FindFirstChild("Humanoid")
			if pRoot and hum and hum.Health > 0 then
				local screenPos, onScreen = camera:WorldToViewportPoint(pRoot.Position)
				if onScreen then
					local screenVec   = Vector2.new(screenPos.X, screenPos.Y)
					local distToCenter = (screenVec - CircleAimCenter).Magnitude
					if distToCenter <= CircleAimRadius and distToCenter < closestDist then
						closestDist = distToCenter
						closest     = p
					end
				end
			end
		end
	end

	if closest then
		local worldDist = (myRoot.Position - closest.Character.HumanoidRootPart.Position).Magnitude
		return closest, worldDist
	end
	return nil, math.huge
end

-- Fallback: jogador vivo mais próximo (usado quando Circle Aim está OFF)
local function GetClosestAlivePlayer()
	local char = LocalPlayer.Character
	if not char then return nil, math.huge end
	local myRoot = char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, math.huge end

	local closest, closestDist = nil, math.huge
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
			local hum   = p.Character:FindFirstChild("Humanoid")
			if pRoot and hum and hum.Health > 0 then
				local dist = (myRoot.Position - pRoot.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest     = p
				end
			end
		end
	end
	return closest, closestDist
end

-- ── Variáveis do Silent Aim V2 ─────────────
local ThrowSilentV2Enabled    = false
local _throwSilentAnimReady   = false
local _throwSilentInputConn   = nil
local _throwSilentEndConn     = nil
local _throwSilentAnimConn    = nil
local _throwSilentCharConn    = nil

local THROW_SILENT_TRIGGER_ANIM_ID = "rbxassetid://15478370930"

local function GetThrowSpeed(dist)
	local t = math.clamp((dist - 20) / 20, 0, 1)
	return 80 + (120 - 80) * t
end

-- FireThrowSilentV2: usa círculo quando ativo, senão usa closest alive
local function FireThrowSilentV2()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local knife = char:FindFirstChild("Knife")
		if not knife or not knife:FindFirstChild("Events") then return end

		local myRoot = char:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end

		-- Seleciona alvo: círculo tem prioridade
		local target, dist
		if CircleAimEnabled then
			target, dist = GetPlayerInsideCircle()
		else
			target, dist = GetClosestAlivePlayer()
		end

		if not target then return end

		local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		if not targetRoot then return end

		local speed       = GetThrowSpeed(dist)
		local throwCF     = CFrame.lookAt(myRoot.Position, targetRoot.Position)
		local travelTime  = dist / speed
		local predictedPos = targetRoot.Position + targetRoot.AssemblyLinearVelocity * travelTime
		local predictedCF = CFrame.new(predictedPos)

		local remote = knife.Events:FindFirstChild("KnifeThrown") or knife.Events:FindFirstChild("Throw")
		if remote then
			remote:FireServer(throwCF, predictedCF, speed)
		end
	end)
end

local function WatchAnimatorForSilentV2(hum)
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then return end

	if _throwSilentAnimConn then _throwSilentAnimConn:Disconnect() _throwSilentAnimConn = nil end

	_throwSilentAnimConn = animator.AnimationPlayed:Connect(function(track)
		if not ThrowSilentV2Enabled then return end
		if track.Animation and track.Animation.AnimationId == THROW_SILENT_TRIGGER_ANIM_ID then
			_throwSilentAnimReady = true
			track.Stopped:Connect(function()
				_throwSilentAnimReady = false
			end)
		end
	end)
end

local function SetThrowSilentV2(active)
	if _throwSilentInputConn  then _throwSilentInputConn:Disconnect()  _throwSilentInputConn  = nil end
	if _throwSilentEndConn    then _throwSilentEndConn:Disconnect()    _throwSilentEndConn    = nil end
	if _throwSilentAnimConn   then _throwSilentAnimConn:Disconnect()   _throwSilentAnimConn   = nil end
	if _throwSilentCharConn   then _throwSilentCharConn:Disconnect()   _throwSilentCharConn   = nil end
	_throwSilentAnimReady = false

	if not active then return end

	local TAP_MAX  = 0.11
	local HOLD_MIN = 0.50
	local _touchTime = nil
	local _holdTask  = nil
	local _fired     = false

	_throwSilentInputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not ThrowSilentV2Enabled then return end
		if gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			_touchTime = tick()
			_fired     = false

			if _holdTask then task.cancel(_holdTask) end
			_holdTask = task.delay(HOLD_MIN, function()
				_fired = true
			end)
		end
	end)

	_throwSilentEndConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
		if not ThrowSilentV2Enabled then return end
		if not _throwSilentAnimReady then return end
		if gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			if _holdTask then task.cancel(_holdTask) _holdTask = nil end
			local duration = _touchTime and (tick() - _touchTime) or 1
			if duration <= TAP_MAX and not _fired then
				_fired = true
				FireThrowSilentV2()
			end
			_touchTime = nil
			_fired     = false
		end
	end)

	local char = LocalPlayer.Character
	if char then WatchAnimatorForSilentV2(char:FindFirstChild("Humanoid")) end

	_throwSilentCharConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
		task.wait(0.3)
		_throwSilentAnimReady = false
		WatchAnimatorForSilentV2(newChar:FindFirstChild("Humanoid"))
	end)
end

