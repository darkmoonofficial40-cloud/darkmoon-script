-- ========================================================
-- ESP & MOVEMENT HELPERS
-- ========================================================
local function removeESP(player)
	if espConnections[player] then
		espConnections[player]:Disconnect()
		espConnections[player] = nil
	end
	local char = player.Character
	if char then
		local existing = char:FindFirstChild("ESPHighlight")
		if existing then
			existing:Destroy()
		end
	end
end

local function createHighlightForPlayer(player)
	if not espEnabled or player == LocalPlayer then
		return
	end
	local char = player.Character
	if not char then
		return
	end
	if not char:FindFirstChild("ESPHighlight") then
		local hl = Instance.new("Highlight")
		hl.Name = "ESPHighlight"
		hl.FillColor = Color3.fromRGB(115, 75, 255)
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.FillTransparency = 0.4
		hl.Adornee = char
		hl.Parent = char
	end
end

local function applyESP(player)
	if player == LocalPlayer then
		return
	end
	removeESP(player)
	espConnections[player] = player.CharacterAdded:Connect(function()
		task.wait(0.25)
		createHighlightForPlayer(player)
	end)
	createHighlightForPlayer(player)
end

local function setESPState(enabled)
	espEnabled = enabled
	if espEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			applyESP(p)
		end
	else
		for _, p in ipairs(Players:GetPlayers()) do
			removeESP(p)
		end
	end
end

local function startFlyLoop()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (root and hum) then
		return
	end

	local bv = Instance.new("BodyVelocity")
	bv.Name = "DarkMoonFlyVelocity"
	bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bv.Velocity = Vector3.zero
	bv.Parent = root

	local bg = Instance.new("BodyGyro")
	bg.Name = "DarkMoonFlyGyro"
	bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	bg.P = 1e4
	bg.CFrame = Camera.CFrame
	bg.Parent = root

	task.spawn(function()
		while flyEnabled and char.Parent and root.Parent and bv.Parent and bg.Parent do
			RunService.RenderStepped:Wait()
			if not flyEnabled then
				break
			end

			local camCFrame = Camera.CFrame
			local moveDir = Vector3.zero

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				moveDir += camCFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				moveDir -= camCFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				moveDir += camCFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				moveDir -= camCFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				moveDir += Vector3.yAxis
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				moveDir -= Vector3.yAxis
			end

			bv.Velocity = moveDir.Magnitude > 0 and (moveDir.Unit * flySpeed) or Vector3.zero
			bg.CFrame = camCFrame
		end

		if bv and bv.Parent then
			bv:Destroy()
		end
		if bg and bg.Parent then
			bg:Destroy()
		end
	end)
end

local function resetCharacterCollisions(character)
	if not character then
		return
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end
end

