local function ClearSpeedGlitchConnections()
	if SpeedGlitchConnection then SpeedGlitchConnection:Disconnect() SpeedGlitchConnection = nil end
	if SpeedGlitchJumpConnection then SpeedGlitchJumpConnection:Disconnect() SpeedGlitchJumpConnection = nil end
	if SpeedGlitchLandConnection then SpeedGlitchLandConnection:Disconnect() SpeedGlitchLandConnection = nil end
