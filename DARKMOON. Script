            row=Color3.fromRGB(48,25,48),
            rowHover=Color3.fromRGB(65,32,62)
        }
        for k,v in pairs(theme) do applyThemeColor(k,v) end
    end)

    buttonRow(settingsLeft,22,"BLUE THEME",C.row,function()
        local theme={
