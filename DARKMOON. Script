local SizeOrder = { "Small", "Medium", "Large" }
ResizeBtn.MouseButton1Click:Connect(function()
	local currentIdx = 2
	for i, key in ipairs(SizeOrder) do
		if key == Settings.PanelSize then
			currentIdx = i
			break
		end
	end
	local nextKey = SizeOrder[(currentIdx % #SizeOrder) + 1]
	applyPanelSize(nextKey)
end)

