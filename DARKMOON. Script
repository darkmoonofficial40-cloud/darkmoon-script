losParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasClearLineOfSight(targetPart, targetCharacter)
	if not Settings.WallCheck then return true end
	losParams.FilterDescendantsInstances = { LocalPlayer.Character, targetCharacter }
	local origin = Camera.CFrame.Position
	local offset = targetPart.Position - origin
	return workspace:Raycast(origin, offset, losParams) == nil
end

local function getCharacterAimPart(char)
	if not char then return nil end
	return char:FindFirstChild(Settings.AimPart) or char:FindFirstChild("HumanoidRootPart")
end

local function getPredictedAimPos(part)
	return part.Position + (part.AssemblyLinearVelocity * Settings.Prediction)
end

local function selectBestAimTarget()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, nil end

	local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
	local bestPart, bestRole = nil, nil
	local bestScore = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then continue end
		local role = getRole(plr)
		if Settings.TargetMurder and role ~= "Murderer" then
			continue
		end

		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local part = getCharacterAimPart(char)
		if char and hum and hum.Health > 0 and part then
			local screenPt, onScreen = Camera:WorldToViewportPoint(part.Position)
			if not onScreen then continue end

			local screenDist = (Vector2.new(screenPt.X, screenPt.Y) - center).Magnitude
			if not Settings.IgnoreFOV and screenDist > Settings.FOVRadius then
				continue
			end

			if hasClearLineOfSight(part, char) and screenDist < bestScore then
				bestScore = screenDist
				bestPart = part
				bestRole = role
			end
		end
	end

	return bestPart, bestRole
end

_G.DarkmoonGetAimPoint = function(fallbackWorldPos)
	if not Settings.SilentAim then
		return fallbackWorldPos
	end
	local part = selectBestAimTarget()
	if part then
		return getPredictedAimPos(part)
	end
	return fallbackWorldPos
end

-- Dropped Gun Detector & Reliable Pickup Helper
local function isPlayerOwnedDescendant(inst)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and inst:IsDescendantOf(plr.Character) then
			return true
		end
		local backpack = plr:FindFirstChild("Backpack")
		if backpack and inst:IsDescendantOf(backpack) then
			return true
		end
	end
	return false
end

local function isGunKeyword(nameStr)
	local lower = string.lower(nameStr)
	return string.find(lower, "gun", 1, true)
		or string.find(lower, "revolver", 1, true)
		or string.find(lower, "pistol", 1, true)
		or string.find(lower, "droppedgun", 1, true)
end

local function getDroppedGunTarget()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isPlayerOwnedDescendant(obj) then continue end

		if obj:IsA("Tool") and isGunKeyword(obj.Name) then
			local part = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
				return obj, part, prompt
			end
		elseif (obj:IsA("BasePart") or obj:IsA("Model")) and isGunKeyword(obj.Name) then
			local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true))
			if part then
				local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
				return obj, part, prompt
			end
		elseif obj:IsA("ProximityPrompt") and obj.Parent and isGunKeyword(obj.Parent.Name) then
			local part = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart", true)
			if part then
				return obj.Parent, part, obj
			end
		end
	end

	return nil, nil, nil
end

local function alreadyOwnsGun()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	return hasRoleTool(char, "gun") or hasRoleTool(backpack, "gun")
		or hasRoleTool(char, "revolver") or hasRoleTool(backpack, "revolver")
end

local function triggerGunTouch(myRoot, gunPart)
	if not myRoot or not gunPart then return end
	if typeof(firetouchinterest) == "function" then
		pcall(function()
			firetouchinterest(myRoot, gunPart, 0)
			task.wait()
			firetouchinterest(myRoot, gunPart, 1)
		end)
	end
end

